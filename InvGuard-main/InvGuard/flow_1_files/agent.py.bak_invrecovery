def _extract_counterexample_bindings(failed_item: dict) -> dict:
    if not isinstance(failed_item, dict):
        return {}
    m = failed_item.get("model")
    if isinstance(m, dict):
        return m
    ms = failed_item.get("model_slice")
    if isinstance(ms, dict):
        return ms
    return {}

def _extract_failed_invariant_lines(
    failed_items: list[dict],
    *,
    dedup: bool = True,
) -> list[str]:
    out, seen = [], set()
    for it in failed_items or []:
        line = (it.get("line") or "").strip()
        if not line:
            continue
        line = final_repair_invariant_line(line)
        key = re.sub(r"\s+", " ", line)
        if dedup and key in seen:
            continue
        seen.add(key)
        out.append(line)
    return out

