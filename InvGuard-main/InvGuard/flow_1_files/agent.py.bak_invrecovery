def _strip_solidity_comments(src: str) -> str:
    src = re.sub(r"//.*?$", "", src or "", flags=re.M)
    src = re.sub(r"/\*.*?\*/", "", src, flags=re.S)
    return src


def _has_function(src: str, fn_name: str) -> bool:
    return re.search(rf"\bfunction\s+{re.escape(fn_name)}\s*\(", src or "") is not None


def _function_body_rough(src: str, fn_name: str) -> str:
    """
    Lightweight extractor. This is not a parser; it is only for mining attack objectives.
    """
    m = re.search(rf"\bfunction\s+{re.escape(fn_name)}\s*\([^)]*\)[^{{]*{{", src or "")
    if not m:
        return ""

    i = m.end()
    depth = 1
    j = i
    while j < len(src) and depth > 0:
        if src[j] == "{":
            depth += 1
        elif src[j] == "}":
            depth -= 1
        j += 1

    return src[i:j - 1]


def _mine_security_obligations(contract_source_text: str) -> List[Dict[str, Any]]:
    """
    Produce attack objectives, not verified invariants.

    These are reviewer-safe because:
      - they are labeled as ATTACK_OBJECTIVE / SECURITY_OBLIGATION;
      - they are not merged into verified_invariants.txt;
      - Flow-2 must validate them concretely using Foundry before any exploit/repair claim.
    """
    src = _strip_solidity_comments(contract_source_text)
    low = src.lower()

    obligations: List[Dict[str, Any]] = []

    has_shares = re.search(r"\bmapping\s*\([^)]*\)\s*(?:public\s+)?shares\s*;", src) is not None
    has_total_shares = re.search(r"\buint(?:256)?\s+(?:public\s+)?totalShares\s*;", src) is not None
    has_receive = re.search(r"\breceive\s*\(\s*\)\s*external\s+payable", src) is not None
    uses_raw_balance = "address(this).balance" in src or "this.balance" in src

    dep_body = _function_body_rough(src, "deposit")
    wdr_body = _function_body_rough(src, "withdraw")

    # ------------------------------------------------------------
    # Share-vault / ERC4626-like accounting obligations.
    # Generic pattern: share supply + raw ETH balance + deposit/withdraw.
    # ------------------------------------------------------------
    if has_shares and has_total_shares and _has_function(src, "deposit") and _has_function(src, "withdraw"):
        obligations.append({
            "id": "SO-SHARE-001",
            "kind": "SECURITY_OBLIGATION",
            "category": "ShareAccounting",
            "title": "First depositor must not capture unaccounted vault assets",
            "severity": "High",
            "functions": ["deposit", "withdraw"],
            "why": (
                "Contract has shares + totalShares + deposit/withdraw. "
                "If the vault can hold assets before the first share mint, the first depositor may receive "
                "a disproportionate claim on assets they did not deposit."
            ),
            "attack_goal": {
                "type": "PROFIT",
                "success_condition": "attacker_final_balance > attacker_initial_balance",
                "state_setup": [
                    "target may already contain ETH before attacker deposit",
                    "attacker deposits a small positive amount",
                    "attacker withdraws the maximum allowed shares"
                ],
                "harness_requirements": [
                    "attacker contract must implement payable receive()",
                    "if withdraw has maxWithdrawBps, withdraw in multiple legal chunks or the largest allowed chunk"
                ]
            },
            "dsl_candidates": [
                "(pre.totalShares == 0 && meta.contract_balance > meta.value) -> (meta.revert_taken == true)",
                "(meta.revert_taken == false) -> (post.totalShares >= pre.totalShares)",
                "(meta.revert_taken == false) -> (select(post.shares, meta.sender) >= select(pre.shares, meta.sender))"
            ],
            "repair_hint": (
                "Do not compute share price from raw address(this).balance. Use accountedAssets, "
                "or reject/don't-account unsolicited ETH."
            )
        })

    if has_shares and has_total_shares and uses_raw_balance and "totalshares" in wdr_body.lower():
        obligations.append({
            "id": "SO-SHARE-002",
            "kind": "SECURITY_OBLIGATION",
            "category": "ShareAccounting",
            "title": "Withdraw payout must not be inflated by unsolicited ETH",
            "severity": "High",
            "functions": ["withdraw"],
            "why": (
                "withdraw appears to compute payout using raw address(this).balance and totalShares. "
                "Raw balance can include unsolicited ETH not represented by shares."
            ),
            "attack_goal": {
                "type": "INFLATED_PAYOUT",
                "success_condition": "withdraw_received > fair_share_of_accounted_assets",
                "state_setup": [
                    "preload target with ETH not created through deposit",
                    "deposit small amount to mint shares",
                    "withdraw legal share amount"
                ],
                "harness_requirements": [
                    "attacker contract must have receive() external payable"
                ]
            },
            "dsl_candidates": [
                "(meta.revert_taken == false) -> (post.totalShares <= pre.totalShares)",
                "(meta.revert_taken == false) -> (select(post.shares, meta.sender) <= select(pre.shares, meta.sender))"
            ],
            "repair_hint": (
                "Introduce accountedAssets and compute payout from accountedAssets rather than address(this).balance."
            )
        })

    if has_receive and has_shares and has_total_shares:
        obligations.append({
            "id": "SO-ETH-RECEIVE-001",
            "kind": "SECURITY_OBLIGATION",
            "category": "UnexpectedEther",
            "title": "Plain ETH receive must not change share redemption economics",
            "severity": "Medium",
            "functions": ["receive", "deposit", "withdraw"],
            "why": (
                "Contract has a payable receive() and share accounting. Direct ETH transfers can create "
                "unaccounted assets unless explicitly treated as donation or rejected."
            ),
            "attack_goal": {
                "type": "DONATION_INFLATION",
                "success_condition": "later depositor or existing shareholder extracts value caused by direct ETH transfer",
                "state_setup": [
                    "send ETH directly to receive() before or between deposits",
                    "compare redeemable value before and after direct transfer"
                ]
            },
            "dsl_candidates": [
                "(meta.revert_taken == false) -> (post.totalShares == pre.totalShares)"
            ],
            "repair_hint": (
                "Either revert receive(), or track donations separately so they cannot inflate attacker redemption."
            )
        })

    # ------------------------------------------------------------
    # External-call obligations.
    # ------------------------------------------------------------
    if ".call" in wdr_body or ".send" in wdr_body or ".transfer" in wdr_body:
        obligations.append({
            "id": "SO-CALL-001",
            "kind": "SECURITY_OBLIGATION",
            "category": "ExternalCall",
            "title": "Withdraw external transfer must be safely handled",
            "severity": "Medium",
            "functions": ["withdraw"],
            "why": (
                "withdraw performs an external value transfer. Attack harness must model receiver behavior, "
                "including payable receive() and reverting receive()."
            ),
            "attack_goal": {
                "type": "EXTERNAL_CALL_BEHAVIOR",
                "success_condition": "unexpected revert, locked funds, or profit after callback behavior",
                "harness_requirements": [
                    "generate one attacker with payable receive()",
                    "generate one attacker with reverting receive()",
                    "generate one attacker that attempts reentry if state update order permits"
                ]
            },
            "dsl_candidates": [
                "(meta.revert_taken == false) -> (post.totalShares <= pre.totalShares)"
            ],
            "repair_hint": (
                "Preserve checks-effects-interactions; consider pull-payment or explicit failed-call behavior."
            )
        })

    # Stable IDs / deterministic order.
    return obligations


def _write_flow1_attack_targets(contract_source_text: str) -> str:
    """
    Write Flow-2 attack objectives separately from verified invariants.
    """
    os.makedirs(FLOW1_ATTACK_TARGETS_DIR, exist_ok=True)

    obligations = _mine_security_obligations(contract_source_text)

    obj = {
        "schema_version": 1,
        "producer": "flow_1_files.agent",
        "policy": (
            "These are attack objectives/security obligations, not verified invariants. "
            "Flow-2 must validate any exploit concretely before repair claims."
        ),
        "obligation_count": len(obligations),
        "obligations": obligations,
    }

    with open(FLOW1_ATTACK_TARGETS_FILE, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2)

    # Convenience per-function files for Flow-2.
    by_fn: Dict[str, List[Dict[str, Any]]] = defaultdict(list)
    for ob in obligations:
        for fn in ob.get("functions", []) or []:
            by_fn[fn].append(ob)

    for fn, obs in by_fn.items():
        p = os.path.join(FLOW1_ATTACK_TARGETS_DIR, f"security_obligations.{fn}.json")
        with open(p, "w", encoding="utf-8") as f:
            json.dump(
                {
                    "schema_version": 1,
                    "function": fn,
                    "obligation_count": len(obs),
                    "obligations": obs,
                },
                f,
                indent=2,
            )

    return FLOW1_ATTACK_TARGETS_FILE

def _emit_taxonomy_outputs(
    *,
    fn_tag: str,
    fn_name_for_scoring: str,
    verified: List[str],
    failed_items: List[Dict[str, Any]],
    trusted: List[str],
    looks_meaningful_fn,
) -> Dict[str, List[str]]:
    """
    Writes:
      invariants.<fn_tag>.VU/VT/VM/UT.txt under FLOW1_VERIFIED_DIR

    Changes applied (pipeline-aligned):
      - ALWAYS final-repair + dedup BEFORE scoring/splitting (stabilizes keys; avoids syntax leakage).
      - VU/VT derived ONLY from VERIFIED invariants, post-repair, post-dedup.
      - VM derived ONLY from FAILED invariants that are meaningful AND not trivial/no-op.
      - UT derived ONLY from TRUSTED invariants, post-sanitize, post-repair, post-dedup.
      - (Optional enforcement hook) If an UNSOUND bucket exists upstream, it must NOT flow into VU/VT/VM/UT.
    """

    # -----------------------------
    # helpers
    # -----------------------------
    def _dedup_stable(lines: List[str]) -> List[str]:
        out, seen = [], set()
        for ln in lines or []:
            s = (ln or "").strip()
            if not s:
                continue
            key = re.sub(r"\s+", " ", s).strip()
            if key in seen:
                continue
            seen.add(key)
            out.append(s)
        return out

    def _final_repair_list(lines: List[str]) -> List[str]:
        # prefer your centralized "final repair" if present
        try:
            if "_final_repair_invariant_lines" in globals():
                return _final_repair_invariant_lines(lines or [])
        except Exception:
            pass
        # fallback: best-effort line repair if helper exists
        out = []
        for ln in lines or []:
            s = (ln or "").strip()
            if not s or s.startswith("#") or s.startswith("//"):
                continue
            try:
                s = final_repair_invariant_line(s)
            except Exception:
                pass
            s = (s or "").strip()
            if s:
                out.append(s)
        return _dedup_stable(out)

    def _sanitize_then_repair(lines: List[str]) -> List[str]:
        x = _sanitize_and_filter_invariants(lines or [], allowed_arg_fields=None)
        return _final_repair_list(x)

    def _is_trivial_or_noop(inv_line: str) -> bool:
        """
        Conservative trivial/no-op detector for VM filtering.
        Prefer utility_score if available; fall back to robust syntactic checks.
        """
        s = (inv_line or "").strip()
        if not s:
            return True

        # Prefer existing scoring heuristics if present
        try:
            if "utility_score" in globals():
                if utility_score(s, fn_name=fn_name_for_scoring) <= 0:
                    return True
        except Exception:
            pass

        low = s.replace(" ", "").lower()

        # explicit known junk
        if "meta.sender==meta.sender" in low:
            return True
        if "pre.owner==pre.owner" in low:
            return True
        if "true==true" in low or "false==false" in low:
            return True
        if re.search(r"\bok==true\b", low) or re.search(r"\bok==1\b", low):
            return True

        # whole-line X == X
        m = re.match(r"^(.*?)(==)(.*?)$", low)
        if m and m.group(1) == m.group(3):
            return True

        # implication with tautological rhs
        if "->" in low:
            rhs = low.split("->", 1)[1].strip()
            m2 = re.match(r"^\(*(.+?)\)*==\(*\1\)*$", rhs)
            if m2:
                return True

        # uint non-negativity (common trivial for uint)
        if re.search(r"select\(post\.[a-z0-9_]+,.*\)\s*>=\s*0", low):
            return True
        if re.search(r"\bpost\.[a-z0-9_]+\s*>=\s*0\b", low):
            return True

        # post == pre no-op transitions
        if ("select(post." in low and "select(pre." in low and "==" in low):
            t = low.replace("select(post.", "select(X.").replace("select(pre.", "select(X.")
            parts = t.split("==")
            if len(parts) == 2 and parts[0].strip() == parts[1].strip():
                return True

        if ("post." in low and "pre." in low and "==" in low):
            t = low.replace("post.", "X.").replace("pre.", "X.")
            parts = t.split("==")
            if len(parts) == 2 and parts[0].strip() == parts[1].strip():
                return True

        return False

    # -----------------------------
    # 1) VERIFIED -> (VU, VT)
    # -----------------------------
    # Repair/dedup first to keep splitting stable + prevent broken strings inflating VU.
    verified_fixed = _final_repair_list(verified or [])
    verified_fixed = _dedup_stable(verified_fixed)

    vu, vt = split_verified_into_useful_vs_trivial(verified_fixed, fn_name=fn_name_for_scoring)

    # Ensure VU/VT are repaired + deduped (split function already dedups, but keep consistent)
    vu = _final_repair_list(vu)
    vt = _final_repair_list(vt)

    # -----------------------------
    # 2) FAILED -> VM (violated-meaningful objectives)
    # -----------------------------
    failed_lines = _extract_failed_invariant_lines(failed_items or [], dedup=True, repair_parens=True)

    # meaning filter first (domain heuristic), then sanitize/repair, then trivial/no-op rejection
    vm_raw = [ln for ln in failed_lines if looks_meaningful_fn(ln)]
    vm = _sanitize_then_repair(vm_raw)

    # final gate: keep VM non-trivial
    vm = [x for x in (vm or []) if not _is_trivial_or_noop(x)]
    vm = _dedup_stable(vm)

    # -----------------------------
    # 3) TRUSTED -> UT
    # -----------------------------
    # Trusted are “unknown”: sanitize/repair, but DO NOT promote into VU.
    ut = _sanitize_then_repair(trusted or [])
    ut = _dedup_stable(ut)

    # -----------------------------
    # 4) write buckets
    # -----------------------------
    _write_taxonomy_bucket(
        os.path.join(FLOW1_VERIFIED_DIR, f"invariants.{fn_tag}.VU.txt"),
        "# VERIFIED-USEFUL (constraints for Flow-2)",
        vu,
    )
    _write_taxonomy_bucket(
        os.path.join(FLOW1_VERIFIED_DIR, f"invariants.{fn_tag}.VT.txt"),
        "# VERIFIED-TRIVIAL (sanity/regression only; NOT for Flow-2)",
        vt,
    )
    _write_taxonomy_bucket(
        os.path.join(FLOW1_VERIFIED_DIR, f"invariants.{fn_tag}.VM.txt"),
        "# VIOLATED-MEANINGFUL (attack objectives for Flow-2)",
        vm,
    )
    _write_taxonomy_bucket(
        os.path.join(FLOW1_VERIFIED_DIR, f"invariants.{fn_tag}.UT.txt"),
        "# UNKNOWN / NOT VERIFIED / EXCLUDED FROM FLOW-2",
        ut,
    )

    return {"VU": vu, "VT": vt, "VM": vm, "UT": ut}

def _run_strength_scoring(
    *,
    contract_path: str,
    invariants_all_path: str,
    z3_root: str,
) -> dict:
    """
    Thin wrapper around invariant_strength.score_invariants_on_contract.
    Returns a dict with keys: scores, strong, weak, mutants (per your invariant_strength.py).

    ✅ REQUIRED CHANGES (Point-5 + soundness-aligned):
      - If invariants_all_path is empty/missing, return empty score structure (no crash).
      - If the run is UNSOUND (e.g., missing bodies / SOLCX empty-body), DO NOT compute strength;
        return empty (and optionally include a flag if upstream passes it via globals).
      - Never allow strength artifacts to be treated as guidance unless produced under a sound model.
    """
    # ------------------------------------------------------------
    # 0) Optional: short-circuit if upstream flagged unsound model
    # ------------------------------------------------------------
    try:
        # If you add an UNSOUND_MODEL flag elsewhere in the pipeline, respect it here.
        # This prevents writing misleading "strong/weak" splits when Z3 didn't model bodies.
        if bool(globals().get("UNSOUND_MODEL", False)):
            return {"scores": [], "strong": [], "weak": [], "mutants": []}
    except Exception:
        pass

    # ------------------------------------------------------------
    # 1) Missing/empty invariants file => empty score structure
    # ------------------------------------------------------------
    if (not invariants_all_path) or (not os.path.exists(invariants_all_path)):
        return {"scores": [], "strong": [], "weak": [], "mutants": []}

    # If file exists but has no usable invariants, treat as empty
    try:
        with open(invariants_all_path, "r", encoding="utf-8") as f:
            any_inv = any(ln.strip() and not ln.strip().startswith("#") for ln in f)
        if not any_inv:
            return {"scores": [], "strong": [], "weak": [], "mutants": []}
    except Exception:
        return {"scores": [], "strong": [], "weak": [], "mutants": []}

    # ------------------------------------------------------------
    # 2) Load contract source (robust)
    # ------------------------------------------------------------
    try:
        with open(contract_path, "r", encoding="utf-8") as f:
            contract_src = f.read()
    except Exception:
        return {"scores": [], "strong": [], "weak": [], "mutants": []}

    # NOTE: score_invariants_on_contract(repo_root, original_contract_src, invariants_txt_path, z3checker_root=..., ...)
    import os as _os
    # Use a shorter timeout for strength scoring to avoid blocking the pipeline.
    # Mutant contracts are run many times; a per-mutant budget of 15s is sufficient
    # to distinguish HOLDS vs VIOLATED on the simple verified invariants.
    _orig_timeout = _os.environ.get("INVGUARD_Z3_TIMEOUT_SEC", "30")
    _os.environ["INVGUARD_Z3_TIMEOUT_SEC"] = "15"
    try:
        return score_invariants_on_contract(
            repo_root=REPO_ROOT,
            original_contract_src=contract_src,
            invariants_txt_path=invariants_all_path,
            z3checker_root=z3_root,
            function_name=None,
            # More mutants → more meaningful kill-rate bands for the stricter
            # STRONG threshold (≥30%). Bounded to keep per-contract runtime sane
            # given the 15s per-mutant Z3 budget set above. Tunable via env.
            max_mutants=int(_os.environ.get("INVGUARD_STRENGTH_MUTANTS", "8")),
        )
    except Exception:
        logging.exception("[FLOW1] strength scoring failed (continuing with empty scores).")
        return {"scores": [], "strong": [], "weak": [], "mutants": []}
    finally:
        _os.environ["INVGUARD_Z3_TIMEOUT_SEC"] = _orig_timeout


def _write_invariant_split_outputs(all_path: str, scores: dict) -> dict:
    """
    Writes:
      - verified_invariants.strong.txt
      - verified_invariants.weak.txt
      - verified_invariants.scores.json

    ✅ REQUIRED CHANGES (Point-5 + pipeline alignment):
      - Always write files (even if empty) for reproducible artifacts.
      - Stable de-dup strong/weak lists.
      - Apply final repair before writing (prevents bracket/guard issues leaking).
      - Enforce "strong-only guides Flow-2" by additionally writing:
            verified.useful.strong.txt
            verified.useful.weak.txt
        (Even if your Flow-2 already points at strong.txt, these filenames make policy explicit.)
    """
    out_dir = os.path.dirname(all_path) if all_path else FLOW1_VERIFIED_DIR
    os.makedirs(out_dir, exist_ok=True)

    strong_path = os.path.join(out_dir, "verified_invariants.strong.txt")
    weak_path = os.path.join(out_dir, "verified_invariants.weak.txt")
    scores_json_path = os.path.join(out_dir, "verified_invariants.scores.json")

    # Policy-explicit copies (Flow-2 should consume only this strong file)
    useful_strong_path = os.path.join(out_dir, "verified.useful.strong.txt")
    useful_weak_path = os.path.join(out_dir, "verified.useful.weak.txt")

    strong = scores.get("strong", []) if isinstance(scores, dict) else []
    medium = scores.get("medium", []) if isinstance(scores, dict) else []
    weak = scores.get("weak", []) if isinstance(scores, dict) else []
    score_rows = scores.get("scores", []) if isinstance(scores, dict) else []
    mutants = scores.get("mutants", []) if isinstance(scores, dict) else []

    # POLICY (Point 5): what guides Flow-2 is the USEFUL set = non-trivial,
    # fault-detecting invariants = STRONG ∪ MEDIUM. The strong/medium split is a
    # reporting gradation only; both tiers detect injected faults and express
    # real relations/relations-to-args, so both are safe to guide repair. Only
    # WEAK (tautological / trivial / no fault detection) is withheld. This keeps
    # the stricter STRONG threshold from starving Flow-2 while preserving the
    # core guarantee that trivial invariants never guide repair.
    useful = list(strong) + [m for m in medium if m not in set(strong)]

    def _dedup(lines: List[str]) -> List[str]:
        out, seen = [], set()
        for ln in lines or []:
            s = (ln or "").strip()
            if not s:
                continue
            key = re.sub(r"\s+", " ", s).strip()
            if key in seen:
                continue
            seen.add(key)
            out.append(s)
        return out

    # Stable de-dup
    strong = _dedup(strong)
    medium = _dedup(medium)
    weak = _dedup(weak)
    useful = _dedup(useful)

    # ✅ final repair before writing (prevents bracket/guard issues leaking)
    try:
        if "_final_repair_invariant_lines" in globals():
            strong = _final_repair_invariant_lines(strong)
            medium = _final_repair_invariant_lines(medium)
            weak = _final_repair_invariant_lines(weak)
            useful = _final_repair_invariant_lines(useful)
    except Exception:
        pass

    # Re-dedup after repair (repair can normalize whitespace/parentheses)
    strong = _dedup(strong)
    medium = _dedup(medium)
    weak = _dedup(weak)
    useful = _dedup(useful)

    # ------------------------------------------------------------
    # Always write artifacts (even if empty)
    # ------------------------------------------------------------
    with open(strong_path, "w", encoding="utf-8") as f:
        f.write("# STRONG VERIFIED-USEFUL INVARIANTS\n")
        for inv in strong:
            f.write(inv.strip() + "\n")

    with open(weak_path, "w", encoding="utf-8") as f:
        f.write("# WEAK VERIFIED-USEFUL INVARIANTS\n")
        for inv in weak:
            f.write(inv.strip() + "\n")

    # Policy-explicit duplicates (Flow-2 should consume useful_strong_path).
    # This file now carries the USEFUL set (STRONG ∪ MEDIUM) per the policy above.
    with open(useful_strong_path, "w", encoding="utf-8") as f:
        f.write("# VERIFIED-USEFUL (STRONG + MEDIUM) — ONLY THESE SHOULD GUIDE FLOW-2\n")
        for inv in useful:
            f.write(inv.strip() + "\n")

    with open(useful_weak_path, "w", encoding="utf-8") as f:
        f.write("# VERIFIED-USEFUL-WEAK (REPORTING ONLY; DO NOT GUIDE FLOW-2)\n")
        for inv in weak:
            f.write(inv.strip() + "\n")

    # Scores JSON (always written)
    try:
        with open(scores_json_path, "w", encoding="utf-8") as f:
            json.dump(
                {
                    "strong": strong,
                    "medium": medium,
                    "useful": useful,
                    "weak": weak,
                    "scores": score_rows,
                    "mutants": mutants,
                    # Optional: propagate an unsound flag if present
                    "unsound_model": bool(globals().get("UNSOUND_MODEL", False)),
                },
                f,
                indent=2,
            )
    except Exception:
        logging.exception("[FLOW1] failed writing verified_invariants.scores.json (continuing).")
        # still return paths even if json write fails

    return {
        "strong_path": strong_path,
        "weak_path": weak_path,
        "scores_json_path": scores_json_path,
        "useful_strong_path": useful_strong_path,
        "useful_weak_path": useful_weak_path,
    }

def _apply_template_rewrites(
    *,
    failed_items: list[dict],
    fn_name: str,
) -> list[str]:
    """
    Implements Step 3.A (counterexample-guided TEMPLATE rewrite) as a reusable function.

    ✅ REQUIRED CHANGES (Points 4 + 5 aligned):
      - Keep rewrite TEMPLATE-based (not free-form regeneration).
      - Ensure meta.revert_taken == false guard is present exactly once.
      - Reject trivial/no-op rewrites (do NOT “rescue” failures into tautologies).
      - Return only DSL-valid lines via _sanitize_and_filter_invariants + final repair.
      - (New) De-dup outputs stably (post repair) so templates don't inflate counts.
    """

    def _repair_missing_parens_local(s: str) -> str:
        s = (s or "").strip()
        if not s:
            return s
        diff = s.count("(") - s.count(")")
        if diff > 0:
            s = s + (")" * diff)
        return s

    def _extract_rhs_only(inv: str) -> str:
        """
        If inv is '(G) -> (RHS)', return RHS only.
        rewrite_invariant() must NEVER receive the full implication.
        """
        s = _repair_missing_parens_local(inv or "")
        s = s.replace("=>", "->")
        if "->" in s:
            return s.split("->", 1)[1].strip()
        return s.strip()

    def _is_trivial_or_noop(inv_line: str) -> bool:
        """
        Reject tautologies / no-ops so template rewrite doesn't degrade into:
          - meta.sender == meta.sender
          - pre.owner == pre.owner
          - X == X
          - uint >= 0 style tautologies
          - post==pre no-op transitions
        """
        s = (inv_line or "").strip()
        if not s:
            return True

        # Prefer existing scoring heuristics if present
        try:
            if "utility_score" in globals():
                if utility_score(s, fn_name=fn_name) <= 0:
                    return True
        except Exception:
            pass

        low = s.replace(" ", "").lower()

        if "meta.sender==meta.sender" in low:
            return True
        if "pre.owner==pre.owner" in low:
            return True

        # whole-line X == X
        m = re.match(r"^(.*?)(==)(.*?)$", low)
        if m and m.group(1) == m.group(3):
            return True

        # implication with tautological rhs
        if "->" in low:
            rhs = low.split("->", 1)[1].strip()
            m2 = re.match(r"^\(*(.+?)\)*==\(*\1\)*$", rhs)
            if m2:
                return True

        # uint non-negativity (common trivial for uint)
        if re.search(r"select\(post\.[a-z0-9_]+,.*\)\s*>=\s*0", low):
            return True
        if re.search(r"\bpost\.[a-z0-9_]+\s*>=\s*0\b", low):
            return True

        # post == pre no-op transitions
        if ("select(post." in low and "select(pre." in low and "==" in low):
            t = low.replace("select(post.", "select(X.").replace("select(pre.", "select(X.")
            parts = t.split("==")
            if len(parts) == 2 and parts[0].strip() == parts[1].strip():
                return True

        if ("post." in low and "pre." in low and "==" in low):
            t = low.replace("post.", "X.").replace("pre.", "X.")
            parts = t.split("==")
            if len(parts) == 2 and parts[0].strip() == parts[1].strip():
                return True

        return False

    def _wrap_with_revert_guard(rhs_or_full: str) -> str:
        """
        Ensure a single top-level implication:
          ((meta.revert_taken == false) -> (RHS))

        ✅ REQUIRED CHANGE:
          - If input already has an implication, ensure it is guarded by revert_taken==false
            exactly once, even if caller returned a different guard.
          - Avoid nested/double guards like:
              ((meta.revert_taken==false)->((meta.revert_taken==false)->RHS))
        """
        s = _repair_missing_parens_local(rhs_or_full or "")
        s = s.replace("=>", "->").strip()

        # If it's already an implication, we ONLY keep the consequent and re-wrap once.
        if "->" in s:
            _, rhs = s.split("->", 1)
            rhs = rhs.strip()
            return f"((meta.revert_taken == false) -> ({rhs}))"

        return f"((meta.revert_taken == false) -> ({s}))"

    rewritten_lines: list[str] = []
    for item in failed_items or []:
        if not isinstance(item, dict):
            continue

        inv_line = _repair_missing_parens_local((item.get("line") or "").strip())
        if not inv_line:
            continue

        ce = _extract_counterexample_bindings(item)

        rhs = _extract_rhs_only(inv_line)
        new_rhs = rewrite_invariant(rhs, ce, fn_name)

        if not (new_rhs and isinstance(new_rhs, str) and new_rhs.strip()):
            continue

        new_rhs = _repair_missing_parens_local(new_rhs.strip())
        candidate = _wrap_with_revert_guard(new_rhs)

        # ✅ REQUIRED: reject trivial/no-op “rescues”
        if _is_trivial_or_noop(candidate):
            continue

        rewritten_lines.append(candidate)

    # One more pass through sanitizer so we return only DSL-valid lines
    rewritten_lines = _sanitize_and_filter_invariants(rewritten_lines, allowed_arg_fields=None)

    # ✅ FINAL PASS REPAIR (consistent with rest of pipeline, if defined)
    try:
        if "_final_repair_invariant_lines" in globals():
            rewritten_lines = _final_repair_invariant_lines(rewritten_lines)
    except Exception:
        pass

    # ✅ NEW: stable de-dup (post-repair) to prevent template duplicates inflating counts
    out: list[str] = []
    seen: set[str] = set()
    for ln in rewritten_lines or []:
        s = (ln or "").strip()
        if not s:
            continue
        key = re.sub(r"\s+", " ", s).strip()
        if key in seen:
            continue
        seen.add(key)
        out.append(s)

    return out


def _final_repair_invariant_lines(lines: List[str]) -> List[str]:
    """
    Apply last-mile robust repair to a list of invariants.
    - drops empties/comments
    - runs final_repair_invariant_line
    - de-dups while preserving order
    """
    out: List[str] = []
    seen: set[str] = set()

    for ln in (lines or []):
        s = (ln or "").strip()
        if not s or s.startswith("#") or s.startswith("//"):
            continue

        s2 = final_repair_invariant_line(s)
        s2 = (s2 or "").strip()
        if not s2:
            continue

        key = re.sub(r"\s+", " ", s2).strip()
        if key in seen:
            continue
        seen.add(key)
        out.append(s2)

    return out

# ============================================================
# ✅ NEW HELPERS (Soundness-first; no report substring guessing)
# ============================================================

def _core_unsound_lines(core: "InvGuardResult") -> List[str]:
    """
    Extract UNSOUND invariant strings from InvGuardResult in a structured way.

    Priority:
      1) core.unsound (adapter fail-closed bucket): [{"line": "...", ...}, ...]
      2) core.report_lines JSONL: status UNVERIFIED_UNSOUND / UNSOUND (best-effort)
      3) fallback: empty
    """
    out: List[str] = []

    if core is None:
        return out

    # 1) Preferred: adapter already separated them into core.unsound
    try:
        u = getattr(core, "unsound", None)
        if isinstance(u, list):
            for item in u:
                if isinstance(item, dict):
                    ln = (item.get("line") or item.get("inv") or item.get("invariant") or "").strip()
                    if ln:
                        try:
                            ln = final_repair_invariant_line(ln)
                        except Exception:
                            pass
                        if ln:
                            out.append(ln)
                elif isinstance(item, str):
                    ln = item.strip()
                    if ln:
                        out.append(ln)
    except Exception:
        pass

    # 2) Best-effort: parse JSONL in report_lines (if driver prints it)
    if not out:
        try:
            import json as _json
            for raw in (getattr(core, "report_lines", None) or []):
                s = (raw or "").strip()
                if not s.startswith("{"):
                    continue
                try:
                    obj = _json.loads(s)
                except Exception:
                    continue
                if not isinstance(obj, dict):
                    continue
                status = str(obj.get("status") or "").upper()
                if "UNSOUND" in status or "UNVERIFIED" in status:
                    ln = (obj.get("inv") or obj.get("line") or "").strip()
                    if ln:
                        try:
                            ln = final_repair_invariant_line(ln)
                        except Exception:
                            pass
                        if ln:
                            out.append(ln)
        except Exception:
            pass

    # 3) stable de-dup (preserve order)
    deduped: List[str] = []
    seen: set[str] = set()
    for ln in out:
        key = re.sub(r"\s+", " ", (ln or "").strip())
        if not key or key in seen:
            continue
        seen.add(key)
        deduped.append(ln)

    return deduped


def _checker_unsound_result(res: "Z3CheckerResult") -> bool:
    """
    True iff checker ran successfully but the model was UNSOUND / UNVERIFIABLE.

    Prefer structured signal:
      - res.unsound_invariants (non-empty)
    Backward compatible fallback:
      - report markers (only if structured signal missing)
    """
    if res is None:
        return True

    try:
        ui = getattr(res, "unsound_invariants", None)
        if isinstance(ui, list) and len(ui) > 0:
            return True
    except Exception:
        pass

    # fallback: legacy substring markers (keep only as backup)
    rep = (getattr(res, "report", "") or "").lower()
    return ("unverified_unsound" in rep) or ("unsound_model" in rep) or ("unmodeled" in rep)


# ----------------------------------------------------
# Tool: call external Z3Checker via the adapter
# ----------------------------------------------------
@function_tool
def z3_checker_tool(
    contract_filename: str = "contract.sol",
    invariants_filename: str = "invariants.txt",
    function_name: str = ""
) -> Z3CheckerResult:
    """
    Tool wrapper around InvGuard/Z3Checker.

    Reviewer-aligned behavior:
      - Split invariants into taxonomy buckets:
          * VU (verified-useful)      -> constraints for Flow-2
          * VT (verified-trivial)     -> sanity/regression only
          * VM (violated-meaningful)  -> attack objectives for Flow-2
          * UT (unknown/trusted)
      - Z3 is used to LABEL invariants (not just filter them).
      - Failed meaningful invariants are preserved as objectives with witnesses.

    REQUIRED SOUNDNESS CHANGE (fail-closed):
      - If checker indicates UNSOUND / UNMODELED semantics, do NOT treat any invariant as verified/trusted.
      - Route UNSOUND to a separate bucket file and exclude from Flow-2 inputs.
      - ✅ ALSO: populate Z3CheckerResult.unsound_invariants (do not infer via report text).
    """

    contract_file = os.path.join(BASE_EXECUTION_DIR, contract_filename)
    if not os.path.exists(contract_file):
        sols = sorted(glob.glob(os.path.join(BASE_EXECUTION_DIR, "*.sol")))
        if sols:
            contract_file = sols[0]

    invariants_txt = os.path.join(BASE_EXECUTION_DIR, invariants_filename)
    z3_root = os.path.join(THIS_DIR, "Z3Checker")

    # ------------------------------------------------------------
    # Infer allowed arg fields from Solidity signatures (best-effort)
    # ------------------------------------------------------------
    def _infer_allowed_arg_fields(sol_path: str, fn: str) -> Optional[set]:
        if not fn:
            return None
        try:
            with open(sol_path, "r", encoding="utf-8") as f:
                src = f.read()
        except Exception:
            return None

        src = re.sub(r"//.*?$", "", src, flags=re.M)
        src = re.sub(r"/\*.*?\*/", "", src, flags=re.S)

        m = re.search(rf"\bfunction\s+{re.escape(fn)}\s*\(([^)]*)\)", src)
        if not m:
            return None

        params = m.group(1).strip()
        if not params:
            return set()

        out = set()
        for part in params.split(","):
            part = part.strip()
            if not part:
                continue
            toks = part.split()
            name = toks[-1] if toks else ""
            if name in {"memory", "calldata", "storage"} and len(toks) >= 2:
                name = toks[-2]
            if re.match(r"^[A-Za-z_]\w*$", name):
                out.add(name)
        return out if out else None

    allowed_args_deposit = _infer_allowed_arg_fields(contract_file, "deposit")
    allowed_args_withdraw = _infer_allowed_arg_fields(contract_file, "withdraw")

    # ------------------------------------------------------------
    # Load + sanitize invariants
    # ------------------------------------------------------------
    with open(invariants_txt, "r", encoding="utf-8") as f:
        raw_lines = [ln.strip() for ln in f if ln.strip()]

    all_lines = _sanitize_and_filter_invariants(raw_lines, allowed_arg_fields=None)
    dep_lines, wdr_lines = _split_dep_withdraw(all_lines)

    if dep_lines:
        dep_lines = _sanitize_and_filter_invariants(dep_lines, allowed_arg_fields=allowed_args_deposit)
    if wdr_lines:
        wdr_lines = _sanitize_and_filter_invariants(wdr_lines, allowed_arg_fields=allowed_args_withdraw)

    # ✅ FINAL PASS REPAIR right before writing Z3 inputs
    dep_lines = _final_repair_invariant_lines(dep_lines)
    wdr_lines = _final_repair_invariant_lines(wdr_lines)

    for p in glob.glob(os.path.join(BASE_EXECUTION_DIR, "invariants.*.filtered.txt")):
        try:
            os.remove(p)
        except Exception:
            pass

    dep_path = os.path.join(BASE_EXECUTION_DIR, "invariants.deposit.filtered.txt")
    wdr_path = os.path.join(BASE_EXECUTION_DIR, "invariants.withdraw.filtered.txt")
    if dep_lines:
        with open(dep_path, "w", encoding="utf-8") as f:
            f.write("\n".join(dep_lines) + "\n")
    if wdr_lines:
        with open(wdr_path, "w", encoding="utf-8") as f:
            f.write("\n".join(wdr_lines) + "\n")

    run_queue = []
    if dep_lines:
        run_queue.append(("deposit", dep_path))
    if wdr_lines:
        run_queue.append(("withdraw", wdr_path))
    if not run_queue:
        run_queue.append((None, invariants_txt))

    merged_verified, merged_failed, report_lines = [], [], []
    merged_unsound: List[str] = []  # ✅ NEW: UNSOUND bucket (fail-closed)

    # ------------------------------------------------------------
    # Meaningfulness heuristic (for VM)
    # ------------------------------------------------------------
    def _looks_meaningful(inv: str) -> bool:
        s = (inv or "").strip()
        if not s:
            return False

        # AC_MEANINGFUL_V2: authorization predicates are meaningful even
        # without pre/post state (access-control security obligations).
        _low_ac = s.lower()
        if (any(_t in _low_ac for _t in ('meta.sender','msg.sender','tx.origin',
                'owner','admin','role','authorized','creator','governance'))
            and any(_op in s for _op in ('==','!=','>=','<=','<','>'))):
            return True

        s0 = s.replace(" ", "")
        m = re.match(r"^(.*?)(==|>=|<=)(.*?)$", s0)
        if m and m.group(1) == m.group(3):
            return False

        low = s.lower()
        has_state = (
            "pre." in low or "post." in low or
            "select(pre." in low or "select(post." in low
        )
        has_relation = (
            ("pre." in low and "post." in low) or
            ("select(pre." in low and "select(post." in low)
        )
        has_amount_value = ("arg." in low) or ("meta.value" in low)
        has_ownerish = ("owner" in low and ("pre." in low or "post." in low))

        if has_relation:
            return True
        if has_state and (has_amount_value or has_ownerish):
            return True
        # ACCESS_CONTROL_MEANINGFUL_PATCH: authorization predicates are
        # meaningful even without pre/post state. An invariant comparing an
        # auth subject (sender/origin/owner/admin/role) is a real security
        # obligation for access-control bugs.
        _auth_terms = ("meta.sender", "msg.sender", "tx.origin",
                       "owner", "admin", "role", "authorized", "creator")
        _has_auth = any(t in low for t in _auth_terms)
        _has_cmp = any(op in s0 for op in ("==", "!=", ">=", "<=", "<", ">"))
        if _has_auth and _has_cmp:
            return True
        return False

    # ------------------------------------------------------------
    # ✅ NEW: detect UNSOUND / UNMODELED model signal (fail-closed)
    # ------------------------------------------------------------
    def _core_is_unsound(core: InvGuardResult) -> bool:
        """
        Treat these as UNSOUND:
          - explicit flags if adapter provides them
          - report_lines / raw report containing common markers
        """
        try:
            if getattr(core, "unsound", False):
                return True
            if getattr(core, "unmodeled", False):
                return True
        except Exception:
            pass

        txt = "\n".join((core.report_lines or [])).lower()
        markers = (
            "unsound_model",
            "unverified_unsound",
            "unmodeled",
            "empty body",
            "function body not parsed",
            "no function body",
        )
        return any(m in txt for m in markers)

    def _write_unsound_bucket(fn_tag: str, lines: List[str], report: str) -> None:
        os.makedirs(FLOW1_VERIFIED_DIR, exist_ok=True)
        p = os.path.join(FLOW1_VERIFIED_DIR, f"invariants.{fn_tag}.UNSOUND.txt")
        with open(p, "w", encoding="utf-8") as f:
            f.write("# UNSOUND / UNVERIFIABLE (function body missing or model incomplete)\n")
            if report:
                f.write("# --- checker report (tail) ---\n")
                tail = report.splitlines()[-60:]
                for ln in tail:
                    f.write("# " + ln.rstrip("\n") + "\n")
            f.write("\n")
            for ln in (lines or []):
                s = (ln or "").strip()
                if s:
                    f.write(s + "\n")

    # ------------------------------------------------------------
    # Main Z3 runs
    # ------------------------------------------------------------
    for fn, inv_path in run_queue:
        _assert_nonempty_invariant_file(
            inv_path,
            f"z3_checker_tool:{fn or 'all'}",
        )

        core: InvGuardResult = run_invguard_core(
            z3checker_root=z3_root,
            contract_path=contract_file,
            invariants_txt_path=inv_path,
            function_name=fn
        )

        fn_key = fn or ""
        rep = "\n".join(core.report_lines or [])

        # ✅ FAIL-CLOSED: if model is UNSOUND, do not accept any verified/trusted
        if _core_is_unsound(core):
            try:
                # record all invariants we attempted (as UNSOUND)
                attempted: List[str] = []
                try:
                    with open(inv_path, "r", encoding="utf-8") as f:
                        attempted = [x.strip() for x in f if x.strip() and not x.strip().startswith("#")]
                except Exception:
                    attempted = []
                attempted = _final_repair_invariant_lines(attempted)
                attempted = [x for x in attempted if x]
                merged_unsound.extend(attempted)
                _write_unsound_bucket(fn or "all", attempted, rep)
            except Exception:
                logging.exception("[FLOW1] Failed to write UNSOUND bucket (continuing).")

            # still include report for debugging; but do NOT merge verified/trusted/failed
            report_lines.append(rep)
            continue

        # ✅ Rescue verified invariants (persist properly)
        for v in (core.verified or []):
            RESCUED_VERIFIED[fn_key].add(v)

        # ✅ Preserve violated-but-meaningful invariants
        for item in (core.failed or []):
            try:
                inv_line = (item.get("line") or item.get("inv") or item.get("invariant") or "").strip()
                if inv_line and _looks_meaningful(inv_line):
                    ATTACK_TARGETS[fn_key].append(item)
            except Exception:
                pass

        merged_verified.extend(core.verified or [])
        merged_failed.extend(core.failed or [])

        if fn:
            try:
                _emit_taxonomy_outputs(
                    fn_tag=fn,
                    fn_name_for_scoring=fn,
                    verified=core.verified or [],
                    failed_items=core.failed or [],
                    trusted=[],  # UNKNOWN/TRUSTED excluded from Flow-2
                    looks_meaningful_fn=_looks_meaningful,
                )
            except Exception:
                logging.exception(f"[FLOW1] Failed taxonomy emit for {fn} (continuing).")

        report_lines.append(rep)

    # ------------------------------------------------------------
    # Merged taxonomy (ALL)
    # ------------------------------------------------------------
    try:
        merged_buckets = _emit_taxonomy_outputs(
            fn_tag="all",
            fn_name_for_scoring="all",
            verified=merged_verified or [],
            failed_items=merged_failed or [],
            trusted=[],  # UNKNOWN/TRUSTED excluded from Flow-2
            looks_meaningful_fn=_looks_meaningful,
        )
        _write_taxonomy_summary_json(
            os.path.join(FLOW1_VERIFIED_DIR, "invariant_summary.json"),
            merged_buckets,
        )
    except Exception:
        logging.exception("[FLOW1] Failed merged taxonomy emit (continuing).")

    # ✅ finalize only VERIFIED-USEFUL invariants for Flow-2
    _finalize_flow2_invariants()

    return Z3CheckerResult(
        verified_invariants=merged_verified,
        failed_invariants=merged_failed,
        trusted_invariants=[],
        unsound_invariants=merged_unsound,   # ✅ REQUIRED
        report="\n\n".join(report_lines),
        returncode=0,
    )

def _run_checker_once_from_python(
    function_name: str = "deposit",
    invariants_filename: str = "invariants.txt"
) -> Z3CheckerResult:
    contract_file = os.path.join(BASE_EXECUTION_DIR, "contract.sol")
    inv_file = os.path.join(BASE_EXECUTION_DIR, invariants_filename)
    z3_root = os.path.join(THIS_DIR, "Z3Checker")

    if not os.path.exists(contract_file):
        logging.warning("[FLOW1] contract.sol not found; checker cannot run.")
        return Z3CheckerResult(report="contract.sol missing", returncode=1)

    if not os.path.exists(inv_file):
        logging.warning(f"[FLOW1] {invariants_filename} not found; checker cannot run.")
        return Z3CheckerResult(report=f"{invariants_filename} missing", returncode=1)

    def _infer_allowed_arg_fields(sol_path: str, fn: str) -> Optional[set]:
        if not fn:
            return None
        try:
            with open(sol_path, "r", encoding="utf-8") as f:
                src = f.read()
        except Exception:
            return None

        src = re.sub(r"//.*?$", "", src, flags=re.M)
        src = re.sub(r"/\*.*?\*/", "", src, flags=re.S)

        m = re.search(rf"\bfunction\s+{re.escape(fn)}\s*\(([^)]*)\)", src)
        if not m:
            return None

        params = m.group(1).strip()
        if not params:
            return set()

        out = set()
        for part in params.split(","):
            part = part.strip()
            if not part:
                continue
            toks = part.split()
            name = toks[-1] if toks else ""
            if name in {"memory", "calldata", "storage"} and len(toks) >= 2:
                name = toks[-2]
            if re.match(r"^[A-Za-z_]\w*$", name):
                out.add(name)

        return out if out else None

    allowed_arg_fields = _infer_allowed_arg_fields(contract_file, function_name)

    def _looks_meaningful(inv: str) -> bool:
        s = (inv or "").strip()
        if not s:
            return False

        # AC_MEANINGFUL_V2: authorization predicates are meaningful even
        # without pre/post state (access-control security obligations).
        _low_ac = s.lower()
        if (any(_t in _low_ac for _t in ('meta.sender','msg.sender','tx.origin',
                'owner','admin','role','authorized','creator','governance'))
            and any(_op in s for _op in ('==','!=','>=','<=','<','>'))):
            return True

        s0 = s.replace(" ", "")
        m = re.match(r"^(.*?)(==|>=|<=)(.*?)$", s0)
        if m and m.group(1) == m.group(3):
            return False

        low = s.lower()
        has_state = (
            ("pre." in low)
            or ("post." in low)
            or ("select(pre." in low)
            or ("select(post." in low)
        )
        has_ownerish = ("owner" in low and ("pre." in low or "post." in low))
        has_relation = (
            ("pre." in low and "post." in low)
            or ("select(pre." in low and "select(post." in low)
        )
        has_amount_value = ("arg." in low) or ("meta.value" in low)

        return bool(has_relation or (has_state and (has_amount_value or has_ownerish)))

    def _core_is_unsound(core: InvGuardResult) -> bool:
        # Prefer explicit adapter bucket.
        try:
            u = getattr(core, "unsound", None)
            if isinstance(u, list) and len(u) > 0:
                return True
        except Exception:
            pass

        # Fallback markers.
        txt = "\n".join((core.report_lines or [])).lower()
        markers = (
            "unsound_model",
            "unverified_unsound",
            "unmodeled",
            "empty body",
            "function body not parsed",
            "no function body",
        )
        return any(m in txt for m in markers)

    try:
        logging.info("[FLOW1] Forcing Z3 check from Python via adapter (deterministic).")

        with open(inv_file, "r", encoding="utf-8") as f:
            raw_lines = [
                ln.strip()
                for ln in f
                if ln.strip() and not ln.strip().startswith("#")
            ]

        fixed_raw: List[str] = []
        for s in raw_lines:
            s = s or ""

            s = re.sub(r"\bmsg\.sender\b", "meta.sender", s)
            s = re.sub(r"\bmsg\.value\b", "meta.value", s)

            s = re.sub(r"\b(pre|post)\.message\.value\b", "meta.value", s)
            s = re.sub(r"\bmessage\.value\b", "meta.value", s)
            s = re.sub(r"\btx\.value\b", "meta.value", s)

            s = re.sub(r"\b(pre|post)\.message\.sender\b", "meta.sender", s)
            s = re.sub(r"\bmessage\.sender\b", "meta.sender", s)
            s = re.sub(r"\btx\.sender\b", "meta.sender", s)
            s = re.sub(r"\btx\.origin\b", "meta.sender", s)

            s = re.sub(r"\bmeta\.(val|amount|msg_value)\b", "meta.value", s)
            s = re.sub(r"\bmeta\.(from|msg_sender)\b", "meta.sender", s)

            s = re.sub(r"\barg\.sender\b", "meta.sender", s)
            s = re.sub(r"\barg\.value\b", "meta.value", s)
            s = re.sub(r"\barg\.meta\.sender\b", "meta.sender", s)
            s = re.sub(r"\barg\.meta\.value\b", "meta.value", s)
            s = re.sub(r"\barg\.meta\.revert_taken\b", "meta.revert_taken", s)

            if re.search(r"\barg\.meta\.", s):
                continue

            s = re.sub(r"\bpre\.sender\b", "meta.sender", s)
            s = re.sub(r"\bpost\.sender\b", "meta.sender", s)

            s = re.sub(r"\bpre\.message\.value\b", "meta.value", s)
            s = re.sub(r"\bpost\.message\.value\b", "meta.value", s)

            s = re.sub(r"\bmeta\.owner\b", "pre.owner", s)

            s = re.sub(r"\barg\.arg\.", "arg.", s)
            s = re.sub(r"\b(post|pre)\.arg\.", "arg.", s)
            s = re.sub(r"\b(post|pre)\.arg\.arg\.", "arg.", s)

            fixed_raw.append(s.strip())

        all_lines = _sanitize_and_filter_invariants(
            fixed_raw,
            allowed_arg_fields=allowed_arg_fields,
        )
        dep_lines, wdr_lines = _split_dep_withdraw(all_lines)

        chosen = (
            dep_lines
            if function_name == "deposit"
            else wdr_lines
            if function_name == "withdraw"
            else all_lines
        )

        # ------------------------------------------------------------------
        # Function-neutral invariants may not be assigned to deposit/withdraw.
        # If the split is empty, fall back to all sanitized invariants.
        # ------------------------------------------------------------------
        if not chosen:
            logging.warning(
                f"[FLOW1] No function-specific invariants for {function_name}; "
                "falling back to all sanitized invariants."
            )
            chosen = list(all_lines or [])

        # ------------------------------------------------------------------
        # If sanitizer removed everything, use only minimal deterministic
        # Z3-safe candidates. Do NOT fall back to raw LLM invariants.
        # ------------------------------------------------------------------
        if not chosen:
            logging.warning(
                f"[FLOW1] Sanitizer removed all invariants for {function_name}; "
                "NOT falling back to raw invariants. Using safe deterministic invariants only."
            )

            chosen = [
                "(meta.revert_taken == false) -> (post.feeBps == pre.feeBps)",
                "(meta.revert_taken == false) -> (post.maxWithdrawBps == pre.maxWithdrawBps)",
            ]

        # Final repair.
        chosen = _final_repair_invariant_lines(chosen)

        # Filter to parser-safe and Z3-safe candidates.
        # _is_budget_safe_z3_candidate now delegates to _is_simple_z3_candidate internally.
        chosen = [x for x in chosen if _is_budget_safe_z3_candidate(x, function_name)]

        # Direction filter: drop invariants that contradict the function's known semantics.
        # deposit: totalShares and shares[sender] strictly INCREASE.
        # withdraw: totalShares and shares[sender] strictly DECREASE.
        def _wrong_direction_for_fn(inv: str, fn: str) -> bool:
            """
            Drop invariants whose direction contradicts the function semantics.
            Infers direction from the function name itself:
            - "removal" functions (withdraw, borrow, remove, burn): state DECREASES
            - "addition" functions (deposit, add, mint, supply): state INCREASES
            """
            low = inv.replace(" ", "").lower()
            fn_low = fn.lower()
            post_shares_lt = "post.shares" in low and "pre.shares" in low and "<=" in inv and "select(post.shares" in inv
            post_shares_gt = "post.shares" in low and "pre.shares" in low and ">=" in inv and "select(post.shares" in inv
            post_ts_lt = "post.totalshares<=pre.totalshares" in low
            post_ts_gt = "post.totalshares>=pre.totalshares" in low

            # Determine function direction from its name
            _removal_keywords = ("withdraw", "borrow", "remove", "burn", "redeem", "exit")
            _addition_keywords = ("deposit", "add", "mint", "supply", "stake", "provide")
            is_removal = any(k in fn_low for k in _removal_keywords)
            is_addition = any(k in fn_low for k in _addition_keywords)

            if is_removal:
                # Removal functions: shares/state DECREASES — drop invariants claiming increase
                if post_ts_gt or post_shares_gt:
                    return True
            elif is_addition:
                # Addition functions: shares/state INCREASES — drop invariants claiming decrease
                if post_ts_lt or post_shares_lt:
                    return True
            return False

        before = len(chosen)
        chosen = [x for x in chosen if not _wrong_direction_for_fn(x, function_name)]
        if len(chosen) < before:
            logging.info(f"[FLOW1] Dropped {before - len(chosen)} wrong-direction invariants for {function_name}.")

        # Keep only non-empty, non-comment lines. These are candidates, not verified outputs.
        chosen = [
            ln.strip()
            for ln in chosen
            if ln and ln.strip() and not ln.strip().startswith("#")
        ]

        # Write debug snapshot before final fallback.
        debug_path = os.path.join(
            BASE_EXECUTION_DIR,
            f"invariants.forced.{function_name}.debug.json",
        )
        with open(debug_path, "w", encoding="utf-8") as f:
            json.dump(
                {
                    "function": function_name,
                    "raw_count": len(raw_lines or []),
                    "fixed_raw_count": len(fixed_raw or []),
                    "sanitized_count": len(all_lines or []),
                    "deposit_count": len(dep_lines or []),
                    "withdraw_count": len(wdr_lines or []),
                    "chosen_count_before_final_fallback": len(chosen or []),
                    "raw_lines": raw_lines,
                    "fixed_raw": fixed_raw,
                    "sanitized": all_lines,
                    "chosen_before_final_fallback": chosen,
                },
                f,
                indent=2,
            )

        # FINAL SAFETY FALLBACK: immediately before writing the Z3 input file.
        # Nothing after this should filter chosen again.
        chosen = [
            ln.strip()
            for ln in (chosen or [])
            if ln and ln.strip() and not ln.strip().startswith("#")
        ]

        if not chosen:
            logging.warning(
                f"[FLOW1] Final chosen set is empty for {function_name}; "
                "using contract-structure accounting candidates instead of config-only fallback."
            )

            if function_name == "deposit":
                chosen = [
                    "(meta.revert_taken == false) -> (post.totalShares >= pre.totalShares)",
                    "(meta.revert_taken == false) -> (select(post.shares, meta.sender) >= select(pre.shares, meta.sender))",
                    "(pre.totalShares == 0 && meta.contract_balance > meta.value) -> (meta.revert_taken == true)",
                ]
            elif function_name == "withdraw":
                chosen = [
                    "(meta.revert_taken == false) -> (post.totalShares <= pre.totalShares)",
                    "(meta.revert_taken == false) -> (select(post.shares, meta.sender) <= select(pre.shares, meta.sender))",
                    "(meta.revert_taken == false) -> (post.feeBps == pre.feeBps)",
                    "(meta.revert_taken == false) -> (post.maxWithdrawBps == pre.maxWithdrawBps)",
                ]
            else:
                chosen = [
                    "(meta.revert_taken == false) -> (post.feeBps == pre.feeBps)",
                    "(meta.revert_taken == false) -> (post.maxWithdrawBps == pre.maxWithdrawBps)",
                ]

        forced_path = os.path.join(
            BASE_EXECUTION_DIR,
            f"invariants.forced.{function_name}.filtered.txt",
        )
        with open(forced_path, "w", encoding="utf-8") as f:
            f.write("\n".join(chosen) + "\n")

        _assert_nonempty_invariant_file(
            forced_path,
            f"_run_checker_once_from_python:{function_name}",
        )

        core: InvGuardResult = run_invguard_core(
            z3checker_root=z3_root,
            contract_path=contract_file,
            invariants_txt_path=forced_path,
            function_name=function_name,
        )

        rep = "\n".join(core.report_lines or [])

        # UNSOUND is not infrastructure failure. Return returncode=0, but populate unsound_invariants.
        if _core_is_unsound(core):
            uns_lines = _core_unsound_lines(core)

            if not uns_lines:
                try:
                    with open(forced_path, "r", encoding="utf-8") as f:
                        uns_lines = [
                            x.strip()
                            for x in f
                            if x.strip() and not x.strip().startswith("#")
                        ]
                    uns_lines = _final_repair_invariant_lines(uns_lines)
                except Exception:
                    uns_lines = []

            return Z3CheckerResult(
                verified_invariants=[],
                failed_invariants=[],
                trusted_invariants=[],
                unsound_invariants=uns_lines,
                report=f"UNSOUND_MODEL for {function_name}: refusing to verify\n{rep}",
                returncode=0,
            )

        fn_key = function_name or ""

        for v in (core.verified or []):
            RESCUED_VERIFIED[fn_key].add(v)

        try:
            _emit_taxonomy_outputs(
                fn_tag=function_name,
                fn_name_for_scoring=function_name,
                verified=core.verified or [],
                failed_items=core.failed or [],
                trusted=[],
                looks_meaningful_fn=_looks_meaningful,
            )
        except Exception:
            logging.exception(
                f"[FLOW1] Failed taxonomy emit (deterministic) for {function_name}."
            )

        try:
            failed_lines = _extract_failed_invariant_lines(
                core.failed or [],
                dedup=True,
                repair_parens=True,
            )
            attack_targets_raw = [ln for ln in failed_lines if _looks_meaningful(ln)]
            attack_targets = _sanitize_and_filter_invariants(
                attack_targets_raw,
                allowed_arg_fields=None,
            )

            try:
                if "_final_repair_invariant_lines" in globals():
                    attack_targets = _final_repair_invariant_lines(attack_targets)
            except Exception:
                pass

            for ln in attack_targets:
                ATTACK_TARGETS[fn_key].append({"line": ln})

            if attack_targets:
                atk_path = os.path.join(
                    BASE_EXECUTION_DIR,
                    f"attack_targets.{function_name}.txt",
                )
                with open(atk_path, "w", encoding="utf-8") as f:
                    f.write("# MEANINGFUL BUT VIOLATED INVARIANTS (ATTACK TARGETS)\n")
                    for inv in attack_targets:
                        f.write(inv + "\n")
        except Exception:
            logging.exception("[FLOW1] Failed to write attack targets (continuing).")

        return Z3CheckerResult(
            verified_invariants=core.verified or [],
            failed_invariants=core.failed or [],
            trusted_invariants=[],
            unsound_invariants=[],
            report=rep,
            returncode=0,
        )

    except Exception as e:
        logging.exception("[FLOW1] Checker failed.")
        return Z3CheckerResult(report=f"checker failed: {e}", returncode=1)
    
def _deterministic_refine_core(
    failed_invariants: List[Dict[str, Any]],
    original_invariants_filename: str,
    refined_invariants_filename: str = "invariants.refined.txt",
    max_bindings: int = 6,
    max_failed: int = 200,
) -> str:
    """
    Deterministically refine invariants using counterexample bindings.

    ✅ REQUIRED CHANGES (reviewer-aligned + general across many contracts):
      - Counterexample-aware, template-based rewriting (guard-first, weaken-second).
      - Do NOT assume any specific arg field name like `arg.amount` (support arg.<any> syntactically).
      - Do NOT hardcode mapping name like `balances` when discarding raw mapping comparisons.
        Instead: discard ONLY when we can identify that <var> is a mapping variable (via MAPPING_VARS).

    ✅ NEW REQUIRED CHANGE (soundness + Point 5 alignment):
      - NEVER accept refinements that collapse into tautologies / no-ops.
      - If a rewrite would become trivial, keep the *original failed* invariant as VM (attack target),
        and do NOT “rescue” it by turning it into meta.sender == meta.sender etc.

    ✅ EXTRA (pipeline alignment):
      - Always ensure meta.revert_taken == false appears exactly once in the top-level guard.
      - Never introduce *semantic* weakening here beyond the allowed templates.
      - Produce only DSL-valid lines when possible by running sanitizer + final repair on outputs.
    """
    orig_path = os.path.join(BASE_EXECUTION_DIR, original_invariants_filename)
    if not os.path.exists(orig_path):
        raise FileNotFoundError(f"Original invariants file not found: {orig_path}")

    with open(orig_path, "r", encoding="utf-8") as f:
        orig_lines = [ln.rstrip("\n") for ln in f]

    def _repair_missing_parens(s: str) -> str:
        s = (s or "").strip()
        if not s:
            return s
        diff = s.count("(") - s.count(")")
        if diff > 0:
            s = s + (")" * diff)
        return s

    def _norm_inv(s: str) -> str:
        s = (s or "").strip()
        s = re.sub(r"\s+", " ", s)
        s = s.replace("=>", "->")
        s = _repair_missing_parens(s)
        return s

    # --------------------------------------------
    # Build line -> counterexample bindings map
    # --------------------------------------------
    cex_by_line: Dict[str, Dict[str, Any]] = {}
    for item in (failed_invariants or [])[:max_failed]:
        if not isinstance(item, dict):
            continue
        line = _norm_inv(item.get("line") or item.get("inv") or item.get("invariant") or "")
        model = item.get("model") or item.get("model_slice") or {}
        if line and isinstance(model, dict) and line not in cex_by_line:
            cex_by_line[line] = model

    # --------------------------------------------
    # Binding filter (generic; do NOT hardcode mapping names)
    # --------------------------------------------
    def _is_good_binding(k: str, v: Any) -> bool:
        if not isinstance(k, str):
            return False
        # Skip giant functional maps / arrays in CE bindings if they leak through
        kl = k.lower()
        if "store(" in kl or "lambda" in kl:
            return False
        if k.startswith(("arg.", "meta.", "pre.", "post.")):
            return True
        return False

    # --- syntactic inference helpers ---
    def _infer_pre_map(inv_l: str) -> str | None:
        m = re.search(r"select\s*\(\s*pre\.([A-Za-z_]\w*)\s*,\s*meta\.sender\s*\)", inv_l)
        return m.group(1) if m else None

    def _infer_post_map(inv_l: str) -> str | None:
        m = re.search(r"select\s*\(\s*post\.([A-Za-z_]\w*)\s*,\s*meta\.sender\s*\)", inv_l)
        return m.group(1) if m else None

    def _is_pure_precondition(inv_l: str) -> bool:
        s = (inv_l or "").strip()

        # ✅ generalized: drop useless always-true BV preconditions like (arg.<x> >= 0)
        if re.search(r"\barg\.[A-Za-z_]\w*\s*>=\s*0\b", s):
            return True

        # no state relation => precondition-ish (arg/meta only)
        if ("pre." not in s) and ("post." not in s) and ("select(pre." not in s) and ("select(post." not in s):
            if ("arg." in s or "meta." in s) and any(op in s for op in [">", "<", "==", "!=", ">=", "<="]):
                return True
        return False

    def _split_guard(inv_l: str) -> tuple[str, str]:
        """
        Split '(G) -> RHS' into (G, RHS). If no guard, returns ("", inv_l).
        Normalizes '=>' to '->' for matching.
        """
        s = _repair_missing_parens((inv_l or "").strip()).replace("=>", "->")
        if "->" not in s:
            return "", s
        parts = s.split("->", 1)
        return parts[0].strip(), parts[1].strip()

    def _strip_outer_parens(expr: str) -> str:
        s = (expr or "").strip()
        if not s:
            return s
        # cheap peel: only if it looks like a single wrapped expression
        if s.startswith("(") and s.endswith(")"):
            # avoid over-stripping on ")(..." patterns
            inner = s[1:-1].strip()
            if inner.count("(") == inner.count(")"):
                return inner
        return s

    def _guard_has_revert(g: str) -> bool:
        low = (g or "").replace(" ", "").lower()
        return "meta.revert_taken" in low

    def _ensure_no_revert_guard(g: str) -> str:
        """
        Ensure (meta.revert_taken == false) is included in the guard.
        Avoid double-adding if it's already present.
        """
        g0 = (g or "").strip()
        if not g0:
            return "(meta.revert_taken == false)"
        if _guard_has_revert(g0):
            return g0
        return f"((meta.revert_taken == false) && ({g0}))"

    def _mk_implies(guard: str, inv: str) -> str:
        """
        Always emit fully parenthesized implication:
            ((GUARD) -> (INV))
        ✅ always include meta.revert_taken == false in guard (exactly once).
        """
        g = _ensure_no_revert_guard((guard or "").strip())
        i = _repair_missing_parens((inv or "").strip().replace("=>", "->"))
        return f"(({g}) -> ({i}))"

    # ============================================================
    # ✅ REQUIRED: discard raw mapping comparisons (generic)
    # ============================================================
    def _is_raw_mapping_compare(inv_l: str) -> bool:
        """
        Detect ONLY "post.X == pre.X" or "post.X != pre.X" (no select/store indexing),
        and discard ONLY if X is known to be a mapping/array-like var via MAPPING_VARS.
        """
        s = (inv_l or "").strip()
        s = _repair_missing_parens(s).replace("=>", "->")
        s0 = re.sub(r"\s+", "", s)

        m = re.match(r"^\(*post\.([A-Za-z_]\w*)\)*(!=|==)\(*pre\.\1\)*$", s0)
        if not m:
            m = re.match(r"^\(*pre\.([A-Za-z_]\w*)\)*(!=|==)\(*post\.\1\)*$", s0)
        if not m:
            return False

        var = m.group(1)

        mapping_vars = globals().get("MAPPING_VARS", None)
        if isinstance(mapping_vars, set) and var in mapping_vars:
            low = s0.lower()
            # raw compare only (no select/store)
            if "select(" in low or "store(" in low:
                return False
            return True

        return False

    # ============================================================
    # ✅ NEW: triviality / no-op rejection gate
    # ============================================================
    def _is_trivial_or_noop(inv_line: str) -> bool:
        """
        Reject refinements that are tautologies or no-ops.
        Uses utility_score (Point 5) if available; otherwise robust syntactic checks.
        """
        s = (inv_line or "").strip()
        if not s:
            return True

        try:
            if "utility_score" in globals():
                if utility_score(s, fn_name="") <= 0:
                    return True
        except Exception:
            pass

        low = s.replace(" ", "").lower()

        if "meta.sender==meta.sender" in low:
            return True
        if "pre.owner==pre.owner" in low:
            return True

        # whole-line X == X
        m = re.match(r"^(.*?)(==)(.*?)$", low)
        if m and m.group(1) == m.group(3):
            return True

        # implication with tautological rhs
        if "->" in low:
            rhs = low.split("->", 1)[1].strip()
            m2 = re.match(r"^\(*(.+?)\)*==\(*\1\)*$", rhs)
            if m2:
                return True

        # uint non-negativity (common trivial)
        if re.search(r"select\(post\.[a-z0-9_]+,.*\)\s*>=\s*0", low):
            return True
        if re.search(r"\bpost\.[a-z0-9_]+\s*>=\s*0\b", low):
            return True

        # post == pre no-op transitions
        if ("select(post." in low and "select(pre." in low and "==" in low):
            t = low.replace("select(post.", "select(X.").replace("select(pre.", "select(X.")
            parts = t.split("==")
            if len(parts) == 2 and parts[0].strip() == parts[1].strip():
                return True

        if ("post." in low and "pre." in low and "==" in low):
            t = low.replace("post.", "X.").replace("pre.", "X.")
            parts = t.split("==")
            if len(parts) == 2 and parts[0].strip() == parts[1].strip():
                return True

        return False

    # ============================================================
    # GUARD-FIRST (generalize arg.<field> instead of arg.amount)
    # ============================================================
    def _guard_fragile_equality(inv_l: str) -> str | None:
        """
        GUARD-FIRST: keep equality but add feasibility guards (overflow/underflow).
        Only applies if the invariant is currently unguarded.
        Emits a single implication with meta.revert_taken guard.
        """
        guard0, rhs = _split_guard(inv_l)

        # already guarded -> don't add a second guard here
        if guard0:
            return None

        rhs = _repair_missing_parens(rhs)

        # post == pre + meta.value  (overflow-safe)
        if re.search(
            r"select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*\+\s*meta\.value",
            rhs,
        ):
            pre_map = _infer_pre_map(rhs) or "balances"
            pre_bal = f"select(pre.{pre_map}, meta.sender)"
            g = f"((meta.value > 0) && ({pre_bal} + meta.value >= {pre_bal}))"
            candidate = _mk_implies(g, rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        # post == pre + arg.<x>  (overflow-safe + non-zero)
        m_add = re.search(
            r"(select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*\+\s*)(arg\.[A-Za-z_]\w*)\b",
            rhs,
        )
        if m_add:
            argx = m_add.group(2)
            pre_map = _infer_pre_map(rhs) or "balances"
            pre_bal = f"select(pre.{pre_map}, meta.sender)"
            g = f"(({argx} > 0) && ({pre_bal} + {argx} >= {pre_bal}))"
            candidate = _mk_implies(g, rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        # post == pre - arg.<x>  (underflow-safe)
        m_sub = re.search(
            r"(select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*-\s*)(arg\.[A-Za-z_]\w*)\b",
            rhs,
        )
        if m_sub:
            argx = m_sub.group(2)
            pre_map = _infer_pre_map(rhs) or "balances"
            pre_bal = f"select(pre.{pre_map}, meta.sender)"
            g = f"({pre_bal} >= {argx})"
            candidate = _mk_implies(g, rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        # meta.value > 0 => post > pre  (strict increase is fragile)
        if re.search(
            r"meta\.value\s*>\s*0\s*(=>|->)\s*select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*>\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)",
            rhs,
        ):
            pre_map = _infer_pre_map(rhs) or "balances"
            post_map = _infer_post_map(rhs) or "balances"
            pre_bal = f"select(pre.{pre_map}, meta.sender)"
            g = f"((meta.value > 0) && ({pre_bal} + meta.value >= {pre_bal}))"
            new_rhs = f"(meta.value > 0) => select(post.{post_map}, meta.sender) >= {pre_bal}"
            candidate = _mk_implies(g, new_rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        return None

    # ============================================================
    # WEAKEN-SECOND (generalize arg.<field>)
    # ============================================================
    def _weaken_if_already_guarded_and_failed(inv_l: str) -> str | None:
        """
        WEAKEN-SECOND: only weaken if invariant is already guarded and still failed.
        Preserve antecedent; always ensure meta.revert_taken == false in guard.
        """
        inv_l = _repair_missing_parens((inv_l or "").replace("=>", "->"))
        guard0, rhs = _split_guard(inv_l)
        if not guard0:
            return None

        guard0 = _ensure_no_revert_guard(_strip_outer_parens(guard0))
        rhs_n = _repair_missing_parens(rhs.replace("=>", "->"))

        # post == pre + meta.value  -> post >= pre
        if re.search(
            r"select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*\+\s*meta\.value",
            rhs_n,
        ):
            pre_map = _infer_pre_map(rhs_n) or "balances"
            post_map = _infer_post_map(rhs_n) or "balances"
            new_rhs = f"select(post.{post_map}, meta.sender) >= select(pre.{pre_map}, meta.sender)"
            candidate = _mk_implies(guard0, new_rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        # post == pre + arg.<x>  -> post >= pre
        if re.search(
            r"select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*\+\s*arg\.[A-Za-z_]\w*\b",
            rhs_n,
        ):
            pre_map = _infer_pre_map(rhs_n) or "balances"
            post_map = _infer_post_map(rhs_n) or "balances"
            new_rhs = f"select(post.{post_map}, meta.sender) >= select(pre.{pre_map}, meta.sender)"
            candidate = _mk_implies(guard0, new_rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        # post == pre - arg.<x>  -> post <= pre
        if re.search(
            r"select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*-\s*arg\.[A-Za-z_]\w*\b",
            rhs_n,
        ):
            pre_map = _infer_pre_map(rhs_n) or "balances"
            post_map = _infer_post_map(rhs_n) or "balances"
            new_rhs = f"select(post.{post_map}, meta.sender) <= select(pre.{pre_map}, meta.sender)"
            candidate = _mk_implies(guard0, new_rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        # pre == post + arg.<x>  -> pre >= post
        if re.search(
            r"select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*\+\s*arg\.[A-Za-z_]\w*\b",
            rhs_n,
        ):
            pre_map = _infer_pre_map(rhs_n) or "balances"
            post_map = _infer_post_map(rhs_n) or "balances"
            new_rhs = f"select(pre.{pre_map}, meta.sender) >= select(post.{post_map}, meta.sender)"
            candidate = _mk_implies(guard0, new_rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        # meta.value > 0 => post > pre  -> meta.value > 0 => post >= pre
        if re.search(
            r"meta\.value\s*>\s*0\s*(=>|->)\s*select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*>\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)",
            rhs_n,
        ):
            pre_map = _infer_pre_map(rhs_n) or "balances"
            post_map = _infer_post_map(rhs_n) or "balances"
            new_rhs = (
                f"(meta.value > 0) => "
                f"select(post.{post_map}, meta.sender) >= select(pre.{pre_map}, meta.sender)"
            )
            candidate = _mk_implies(guard0, new_rhs)
            return None if _is_trivial_or_noop(candidate) else candidate

        return None

    # ============================================================
    # Template guard (generalize arg.<field>)
    # ============================================================
    def _template_guard(inv_line: str, model_slice: Dict[str, Any]) -> str | None:
        """
        Counterexample-aware, template-based guard generator.
        (Generic fallback; guarded fragile equalities are handled earlier.)
        Returns a GUARD fragment only (not the whole implication).
        """
        inv_l = (inv_line or "").strip()

        # "+ meta.value" overflow-avoidance monotonicity guard
        if re.search(r"\+\s*meta\.value\b", inv_l):
            pre_map = _infer_pre_map(inv_l) or "balances"
            if re.search(r"select\s*\(\s*pre\.", inv_l):
                x = f"select(pre.{pre_map}, meta.sender)"
                return f"((meta.value > 0) && ({x} + meta.value >= {x}))"
            return "(meta.value > 0)"

        # post = pre - arg.<x>  (underflow)
        m_sub = re.search(
            r"select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*-\s*(arg\.[A-Za-z_]\w*)\b",
            inv_l,
        )
        if m_sub:
            argx = m_sub.group(1)
            pre_map = _infer_pre_map(inv_l) or "balances"
            pre_bal = f"select(pre.{pre_map}, meta.sender)"
            return f"(({argx} > 0) && ({pre_bal} >= {argx}))"

        # post = pre + arg.<x>  (overflow)
        m_add = re.search(
            r"select\s*\(\s*post\.[^,]+,\s*meta\.sender\s*\)\s*==\s*select\s*\(\s*pre\.[^,]+,\s*meta\.sender\s*\)\s*\+\s*(arg\.[A-Za-z_]\w*)\b",
            inv_l,
        )
        if m_add:
            argx = m_add.group(1)
            pre_map = _infer_pre_map(inv_l) or "balances"
            pre_bal = f"select(pre.{pre_map}, meta.sender)"
            return f"(({argx} > 0) && ({pre_bal} + {argx} >= {pre_bal}))"

        return None

    def _mk_guard(inv_line: str, model_slice: Dict[str, Any]) -> str:
        g = _template_guard(inv_line, model_slice)
        if g:
            return _ensure_no_revert_guard(g)

        # fallback: CE-blacklisting (avoid repeating exact CE)
        bindings: List[str] = []
        for k, v in (model_slice or {}).items():
            if not _is_good_binding(k, v):
                continue
            vv = str(v)
            bindings.append(f"({k} != {vv})")
            if len(bindings) >= max_bindings:
                break
        if not bindings:
            return "(meta.revert_taken == false)"
        return _ensure_no_revert_guard("(" + " || ".join(bindings) + ")")

    # ============================================================
    # Main rewrite pass over original file lines
    # ============================================================
    refined_lines: List[str] = []

    for ln in orig_lines:
        stripped = (ln or "").strip()
        if not stripped or stripped.startswith("#"):
            refined_lines.append(ln)
            continue

        stripped = _repair_missing_parens(stripped)
        key = _norm_inv(stripped)

        if key in cex_by_line:
            # ✅ discard raw mapping comparisons (generic, mapping-vars aware)
            if _is_raw_mapping_compare(stripped):
                refined_lines.append(f"# [DISCARDED:raw_mapping_compare] {stripped}")
                continue

            # 1) discard pure preconditions
            if _is_pure_precondition(stripped):
                refined_lines.append(f"# [DISCARDED:not_an_invariant] {stripped}")
                continue

            # 2) GUARD-FIRST
            guarded = _guard_fragile_equality(stripped)
            if guarded is not None:
                refined_lines.append(guarded)
                continue

            # 3) WEAKEN-SECOND
            weakened2 = _weaken_if_already_guarded_and_failed(stripped)
            if weakened2 is not None:
                refined_lines.append(weakened2)
                continue

            # 4) fallback: template guard / CE-blacklisting guard
            guard = _mk_guard(stripped, cex_by_line[key])
            inv = _repair_missing_parens(stripped.replace("=>", "->"))

            if "->" in inv:
                # preserve existing antecedent; ensure revert guard once
                g0, rhs0 = _split_guard(inv)
                candidate = _mk_implies(g0, rhs0)
            else:
                candidate = _mk_implies(guard, inv)

            # ✅ NEW: if fallback refinement becomes trivial, do NOT accept
            if _is_trivial_or_noop(candidate):
                refined_lines.append(f"# [REJECTED:trivial_refinement] {candidate}")
                refined_lines.append(f"# [KEPT_FAILED_AS_VM] {stripped}")
            else:
                refined_lines.append(candidate)
        else:
            refined_lines.append(_repair_missing_parens(stripped))

    # ============================================================
    # Last-mile sanitize + final repair (DSL validity)
    # ============================================================
    try:
        # Keep comments as-is, sanitize only non-comment lines
        sanitized: List[str] = []
        tmp = []
        for ln in refined_lines:
            s = (ln or "").rstrip("\n")
            if not s.strip() or s.lstrip().startswith("#"):
                sanitized.append(s)
                continue
            tmp.append(s.strip())

        tmp2 = _sanitize_and_filter_invariants(tmp, allowed_arg_fields=None)

        # put sanitized invariants back, preserving comments order crudely:
        # (comments already in sanitized; append cleaned invariants after)
        try:
            if "_final_repair_invariant_lines" in globals():
                tmp2 = _final_repair_invariant_lines(tmp2)
        except Exception:
            pass

        # remove any trivial/no-op that slipped through
        tmp2 = [x for x in tmp2 if not _is_trivial_or_noop(x)]

        # final assembly: keep existing comments, then cleaned invariants
        refined_lines = [x for x in sanitized if x.strip() and x.lstrip().startswith("#")]
        refined_lines.extend(tmp2)
    except Exception:
        # if sanitizer fails, still write what we have
        pass

    out_path = os.path.join(BASE_EXECUTION_DIR, refined_invariants_filename)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write("\n".join(refined_lines) + "\n")

    logging.info(f"[det-refine] wrote refined invariants -> {out_path}")
    return refined_invariants_filename


def deterministic_refine_invariants(
    failed_invariants_json: str,
    original_invariants_filename: str = "invariants.txt",
    refined_invariants_filename: str = "invariants.refined.txt",
    max_bindings: int = 6,
    max_failed: int = 200,
) -> str:
    """
    Pure Python entrypoint (callable from main()).

    ✅ REQUIRED CHANGE:
      - This must be a THIN WRAPPER over _deterministic_refine_core(...).
      - Do NOT duplicate refinement logic here (prevents drift + malformed implications).
    """
    import json
    from typing import List, Dict, Any

    # Parse JSON safely
    try:
        parsed = json.loads(failed_invariants_json or "[]")
        if not isinstance(parsed, list):
            parsed = []
    except Exception:
        parsed = []

    # Keep only dict entries, bounded
    failed_invariants: List[Dict[str, Any]] = []
    for item in parsed[:max_failed]:
        if isinstance(item, dict):
            failed_invariants.append(item)

    # Delegate to the single authoritative implementation
    return _deterministic_refine_core(
        failed_invariants=failed_invariants,
        original_invariants_filename=original_invariants_filename,
        refined_invariants_filename=refined_invariants_filename,
        max_bindings=max_bindings,
        max_failed=max_failed,
    )


