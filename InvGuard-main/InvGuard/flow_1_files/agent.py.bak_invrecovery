BAD_INVARIANT_MARKERS = [
    "UNVERIFIED_UNSOUND",
    "REJECTED_UNSUPPORTED",
    "TRANSLATION_FAILED",
    "BUILTIN_FALLBACK",
    "LLM_INVARIANT_NOT_TRANSLATED",
    "PLACEHOLDER_INVARIANT",
    "NOT_A_REAL_VERIFIED_INVARIANT",
    "TRIVIAL_INVARIANT_NOT_USEFUL",
    "reason=",
]

_PLACEHOLDER_INV_RE = re.compile(r"^<inv_\d+>$")


def _is_real_verified_invariant_line(line: str) -> bool:
    """
    Final fail-closed gate before any invariant is allowed to guide Flow-2.
    """
    s = (line or "").strip()

    if not s:
        return False

    if s.startswith("#") or s.startswith("//"):
        return False

    if _PLACEHOLDER_INV_RE.fullmatch(s):
        return False

    if any(marker in s for marker in BAD_INVARIANT_MARKERS):
        return False

    if s.lower() in {
        "true",
        "(true)",
        "trivial true",
        "meta.sender == meta.sender",
        "(meta.sender == meta.sender)",
    }:
        return False

    return True


def _dedup_invariant_lines(lines: List[str]) -> List[str]:
    out, seen = [], set()

    for ln in lines or []:
        s = (ln or "").strip()

        if not _is_real_verified_invariant_line(s):
            continue

        try:
            s = final_repair_invariant_line(s)
        except Exception:
            pass

        s = (s or "").strip()

        if not _is_real_verified_invariant_line(s):
            continue

        key = re.sub(r"\s+", " ", s).strip()

        if key in seen:
            continue

        seen.add(key)
        out.append(s)

    return out

def _is_simple_z3_candidate(inv: str) -> bool:
    """
    Parser-safety filter only.

    IMPORTANT:
      This must NOT filter by semantic importance.
      The old version allowed only feeBps/maxWithdrawBps and deleted
      all share-accounting invariants before Z3 could see them.
    """
    s = (inv or "").strip()
    if not s:
        return False

    low = s.replace(" ", "").lower()

    # Hard unsupported constructs only.
    banned = [
        "forall",
        "exists",
        "selfdestruct",
        "delegatecall",
        "staticcall",
        ".call{",
        ".call(",
        "call.value",
        "payable(",
        "block.timestamp",
        "block.number",
    ]

    if any(b in low for b in banned):
        return False

    # Must be DSL-like.
    if not re.search(r"\b(pre|post|meta|arg)\.", s):
        return False

    # Must contain a relation or implication.
    if not any(op in s for op in ["==", "!=", ">=", "<=", ">", "<", "->", "=>"]):
        return False

    # Parentheses must be balanced after final repair.
    try:
        repaired = final_repair_invariant_line(s)
        if repaired.count("(") != repaired.count(")"):
            return False
    except Exception:
        return False

    # Raw Solidity mapping syntax should have been normalized to select(...).
    if re.search(r"\b[A-Za-z_]\w*\s*\[", s):
        return False

    return True

def _is_budget_safe_z3_candidate(inv: str, function_name: str = "") -> bool:
    """
    Parser-safety and Z3-safety filter for invariants.

    Blocks patterns that cause Z3 nonlinear blowup or parser failures.
    Does NOT use a hardcoded allowlist - all invariants that pass the
    syntax/safety checks are forwarded to Z3.
    """
    s = (inv or "").strip()
    if not s:
        return False

    low = s.replace(" ", "").lower()

    # Block patterns that cause Z3 nonlinear arithmetic blowup.
    blowup_banned = [
        "ite(",
        "call(",
        "delegatecall",
        "staticcall",
        "block.timestamp",
        "block.number",
    ]
    if any(b in low for b in blowup_banned):
        return False

    # Block invariants referencing local/intermediate variables that are abstracted
    # to fresh tmp.* symbols in the Z3 model. The translator cannot resolve these
    # bare names and emits REJECTED_UNSUPPORTED, wasting a Z3 call.
    # Common local vars in ShareVault-style contracts:
    local_vars = ["minted", "prevbal", "payout", "sendamt", "fee", "data", "retval"]
    # Only block if the bare name appears as a standalone symbol (not part of post./pre./arg.)
    import re as _re_lv
    for lv in local_vars:
        # Match bare local var: not preceded by . (so not post.minted or pre.minted)
        if _re_lv.search(rf"(?<![A-Za-z0-9_.]){re.escape(lv)}(?![A-Za-z0-9_])", low):
            return False

    # Block invariants with complex preconditions that depend on the abstracted division model.
    # E.g.: (pre.totalShares == 0 && meta.contract_balance > meta.value) -> (revert_taken == true)
    # These are attack-goal invariants (precondition checks), not preservation invariants.
    # They require the minted calculation to be precise, but we've abstracted it.
    if "->" in s and "&&" in s:
        # Has compound precondition - only allow if rhs is a simple state equality
        lhs_part = s.split("->")[0]
        if "&&" in lhs_part and ("pre." in lhs_part or "meta." in lhs_part):
            # Too complex for abstract model - drop
            return False

    # Delegate to simple syntax check
    return _is_simple_z3_candidate(inv)

