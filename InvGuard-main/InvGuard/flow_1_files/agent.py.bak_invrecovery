_CRITICAL_STATE_HINTS = (
    "balances", "balance",
    "shares", "share", "totalshares",
    "allowance", "allowances",
    "owner", "admins", "admin",
    "totalsupply", "supply",
    "price", "oracle",
    "reserve", "reserves",
    "asset", "assets", "accountedassets",
    "debt", "collateral",
    "payout", "sendamt", "fee"
)

_MUTATING_FN_HINTS = ("deposit", "mint", "increase", "add", "credit", "stake", "supply")

def _is_type_tautology(inv: str) -> bool:
    low = (inv or "").replace(" ", "").lower()
    # Common uint tautology patterns in your DSL
    if re.search(r"select\(post\.[a-z0-9_]+\s*,.*\)\s*>=\s*0", low):
        return True
    if re.search(r"\bpost\.[a-z0-9_]+\s*>=\s*0\b", low):
        return True
    # X == X
    m = re.match(r"^(.*?)(==)(.*?)$", low)
    if m and m.group(1) == m.group(3):
        return True
    return False

def _is_noop_transition(inv: str) -> bool:
    low = (inv or "").replace(" ", "").lower()
    # post == pre on same expression (esp mapping select)
    if "select(post." in low and "select(pre." in low and "==" in low:
        l = low.replace("select(post.", "select(X.").replace("select(pre.", "select(X.")
        parts = l.split("==")
        if len(parts) == 2 and parts[0].strip() == parts[1].strip():
            return True
    if "post." in low and "pre." in low and "==" in low:
        l = low.replace("post.", "X.").replace("pre.", "X.")
        parts = l.split("==")
        if len(parts) == 2 and parts[0].strip() == parts[1].strip():
            return True
    return False

def utility_score(inv: str, fn_name: str = "") -> int:
    """
    Cheap, explainable utility score (for Point 5: weak vs useful invariants).

    ✅ REQUIRED CHANGES:
      - Stronger penalties for tautologies/no-ops so they don't leak into VU.
      - Positive signal for state-transition constraints (pre/post + arithmetic).
      - Explicit negative signal for constant-true patterns like (ok == true).
      - (New) Penalize pure-preconditions (no pre/post) so they don't get classified as “useful”.
    """
    s = (inv or "").strip()
    low = s.lower()
    score = 0

    # +3 if relates pre<->post (state transition constraint)
    has_pre = ("pre." in low) or ("select(pre." in low)
    has_post = ("post." in low) or ("select(post." in low)
    if has_pre and has_post:
        score += 3

    # +2 if uses arg.* or meta.* (input-aware)
    if "arg." in low or "meta." in low:
        score += 2

    # +2 if touches critical state vars
    if any(h in low for h in _CRITICAL_STATE_HINTS):
        score += 2

    # +1 if implication present (often indicates conditional invariant)
    if "->" in s or "=>" in s:
        score += 1

    # +1 if arithmetic present (often indicates quantitative relation)
    if re.search(r"[+\-*/]", s):
        score += 1

    # -5 tautology
    if _is_type_tautology(s):
        score -= 5

    # -4 / -3 no-op transitions
    if _is_noop_transition(s):
        if any(fn_name.lower().startswith(h) for h in _MUTATING_FN_HINTS):
            score -= 4
        else:
            score -= 3

    # -4 constant-true / meaningless booleans (common LLM junk)
    if re.search(r"\bok\s*==\s*true\b", low) or re.search(r"\bok\s*==\s*1\b", low):
        score -= 4
    if re.search(r"\btrue\s*==\s*true\b", low) or re.search(r"\bfalse\s*==\s*false\b", low):
        score -= 6
    if re.search(r"\bmeta\.sender\s*==\s*meta\.sender\b", low):
        score -= 6

    # ✅ NEW: penalize “pure preconditions” (arg/meta-only comparisons)
    # These are often valid but not useful invariants for guidance.
    if (not has_pre) and (not has_post):
        # comparisons / boolean structure indicates “precondition-ish”
        if ("arg." in low or "meta." in low) and any(op in s for op in [">", "<", "==", "!=", ">=", "<="]):
            score -= 3

    return score


def split_verified_into_useful_vs_trivial(
    verified: List[str],
    fn_name: str = "",
) -> Tuple[List[str], List[str]]:
    """
    Split VERIFIED invariants into:
      - VU: verified-useful (sent to Flow-2 as constraints / guidance)
      - VT: verified-trivial (kept only for sanity/regression, not guidance)

    ✅ REQUIRED CHANGE:
      - De-duplicate within each bucket using canonical whitespace collapse.
      - (New) Run final_repair_invariant_line before scoring/dedup (stabilizes keys).
    """
    vu, vt = [], []
    seen_vu, seen_vt = set(), set()

    for inv in verified or []:
        inv = (inv or "").strip()
        if not inv:
            continue

        # ✅ NEW: stabilize before scoring/dedup
        try:
            inv = final_repair_invariant_line(inv)
        except Exception:
            pass
        inv = (inv or "").strip()
        if not inv:
            continue

        sc = utility_score(inv, fn_name=fn_name)
        key = re.sub(r"\s+", " ", inv).strip()

        if sc >= 2:
            if key in seen_vu:
                continue
            seen_vu.add(key)
            vu.append(inv)
        else:
            if key in seen_vt:
                continue
            seen_vt.add(key)
            vt.append(inv)

    return vu, vt

def _write_taxonomy_bucket(path: str, header: str, lines: List[str]) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(header.strip() + "\n")
        for ln in (lines or []):
            ln = (ln or "").strip()
            if not ln:
                continue
            f.write(ln + "\n")

def _write_taxonomy_summary_json(path: str, buckets: Dict[str, List[str]]) -> None:
    obj = {}
    for k, v in buckets.items():
        obj[k] = {"count": len(v or []), "examples": (v[:8] if v else [])}
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, indent=2)

