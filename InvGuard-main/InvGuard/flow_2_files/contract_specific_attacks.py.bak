}


def get_contract_specific_attack(contract_src, stem=None):
    """Return a contract-specific template attack for the given stem, or None."""
    if not stem:
        stem = os.environ.get("INVGUARD_STEM", "")
    fn = _STEM_MAP.get(stem)
    if fn:
        return fn(contract_src)
    return None
