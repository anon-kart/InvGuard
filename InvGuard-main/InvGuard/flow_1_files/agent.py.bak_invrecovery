def _find_contract_on_disk() -> str:
    if CONTRACT_FILE:
        candidate = CONTRACT_FILE
        if not os.path.isabs(candidate):
            # Try REPO_ROOT first (contracts/ lives at repo root), then THIS_DIR
            candidate_repo = os.path.normpath(os.path.join(REPO_ROOT, candidate))
            candidate_here = os.path.normpath(os.path.join(THIS_DIR, candidate))
            if os.path.exists(candidate_repo) and os.path.isfile(candidate_repo):
                candidate = candidate_repo
            elif os.path.exists(candidate_here) and os.path.isfile(candidate_here):
                candidate = candidate_here
        if os.path.exists(candidate) and os.path.isfile(candidate):
            return candidate
        raise FileNotFoundError(f"CONTRACT_FILE specified but not found: {candidate}")

    search_dir = CONTRACTS_DIR
    if not os.path.isabs(search_dir):
        search_dir = os.path.normpath(os.path.join(THIS_DIR, search_dir))
    if os.path.isdir(search_dir):
        sols = sorted(
            [os.path.join(search_dir, f) for f in os.listdir(search_dir) if f.lower().endswith(".sol")]
        )
        if sols:
            return sols[0]
    return ""

def _load_contract_to_base(contract_path: str, dest_filename: str = "contract.sol") -> str:
    import shutil

    if not os.path.exists(contract_path):
        raise FileNotFoundError(f"Contract file not found: {contract_path}")

    dest = os.path.join(BASE_EXECUTION_DIR, dest_filename)

    # 1) Copy EXACT bytes (no decoding/encoding transformation, no regex)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    shutil.copyfile(contract_path, dest)

    # 2) Hard fail if anything differs (this catches hidden mutations immediately)
    with open(contract_path, "rb") as f1, open(dest, "rb") as f2:
        b1, b2 = f1.read(), f2.read()
    if b1 != b2:
        # Give a helpful hint: show where it starts differing
        n = min(len(b1), len(b2))
        i = 0
        while i < n and b1[i] == b2[i]:
            i += 1
        raise RuntimeError(
            f"Contract copy mismatch! First differing byte offset={i}. "
            f"Refusing to proceed. Source={contract_path} Dest={dest}"
        )

    return dest

def _assert_nonempty_invariant_file(path: str, label: str) -> None:
    """
    Fail-closed preflight before calling Z3Checker.

    This prevents driver.py from receiving an empty invariant file and returning
    misleading placeholder diagnostics like <no-llm-invariants>.
    """
    if not os.path.exists(path):
        raise FileNotFoundError(f"{label}: invariant file missing: {path}")

    with open(path, "r", encoding="utf-8") as f:
        lines = [
            ln.strip()
            for ln in f
            if ln.strip() and not ln.strip().startswith("#")
        ]

    if not lines:
        raise RuntimeError(
            f"{label}: invariant file is empty before Z3Checker call: {path}. "
            "This means Flow-1 filtering removed all invariants. "
            "Do not call driver.py with an empty invariant file."
        )

# ------------------------------------------------------------
# Invariant repair (PARSER-ONLY, NO SEMANTIC CHANGES)
# ------------------------------------------------------------

def final_repair_invariant_line(inv: str) -> str:
    """
    Parser-only repair (reviewer-proof):
      - normalize => to ->
      - ensure (G) -> (RHS)
      - balance parentheses
    ❌ No semantic weakening or strengthening
    """
    s = (inv or "").strip()
    if not s:
        return s

    s = re.sub(r"\s+", " ", s).strip()
    s = s.replace("=>", "->")

    depth = 0
    for i in range(len(s) - 1):
        if s[i] == "(":
            depth += 1
        elif s[i] == ")":
            depth -= 1
        elif s[i:i+2] == "->" and depth == 0:
            g = s[:i].strip()
            rhs = s[i+2:].strip()
            if not g.startswith("("):
                g = f"({g})"
            if not rhs.startswith("("):
                rhs = f"({rhs})"
            s = f"{g} -> {rhs}"
            break

    diff = s.count("(") - s.count(")")
    if diff > 0:
        s = s + (")" * diff)

    return s

