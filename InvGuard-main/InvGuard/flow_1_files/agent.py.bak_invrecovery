def _split_verified_into_useful_vs_trivial(
    verified: List[str],
    strength_scores: Dict[str, Dict[str, Any]],
) -> Tuple[List[str], List[str]]:
    strong, weak = [], []
    for inv in verified:
        sc = strength_scores.get(inv, {})
        if sc.get("strength") == "STRONG":
            strong.append(inv)
        else:
            weak.append(inv)
    return strong, weak

def _finalize_flow2_invariants() -> str:
    """
    Final Flow-2 input writer.

    ICSE-safe policy:
      - Flow-2 receives ONLY verified-useful invariants.
      - UNKNOWN/TRUSTED/UNSOUND/REJECTED files are never merged.
      - Placeholder invariants like <inv_1> are never merged.
      - If no verified-useful invariant exists, write an explicit empty status.
    """

    os.makedirs(FLOW1_VERIFIED_DIR, exist_ok=True)

    def _read_invariants_from_file(path: str) -> List[str]:
        if not os.path.exists(path):
            return []

        out = []

        try:
            with open(path, "r", encoding="utf-8") as f:
                for ln in f:
                    s = ln.strip()
                    if _is_real_verified_invariant_line(s):
                        out.append(s)
        except Exception:
            return []

        return _dedup_invariant_lines(out)

    # ---------------------------------------------------------
    # Preferred source: taxonomy VU files.
    # These are verified-useful invariants only.
    # ---------------------------------------------------------
    candidate_files = [
        os.path.join(FLOW1_VERIFIED_DIR, "invariants.all.VU.txt"),
        os.path.join(FLOW1_VERIFIED_DIR, "invariants.deposit.VU.txt"),
        os.path.join(FLOW1_VERIFIED_DIR, "invariants.withdraw.VU.txt"),
        os.path.join(FLOW1_VERIFIED_DIR, "invariants.deposit.rewrite.VU.txt"),
        os.path.join(FLOW1_VERIFIED_DIR, "invariants.withdraw.rewrite.VU.txt"),
        os.path.join(FLOW1_VERIFIED_DIR, "invariants.deposit.refined.VU.txt"),
        os.path.join(FLOW1_VERIFIED_DIR, "invariants.withdraw.refined.VU.txt"),
    ]

    merged: List[str] = []

    for p in candidate_files:
        merged.extend(_read_invariants_from_file(p))

    # ---------------------------------------------------------
    # Rescue bucket is allowed only after utility filtering.
    # Do NOT blindly merge RESCUED_VERIFIED because it may contain trivial invariants.
    # ---------------------------------------------------------
    try:
        rescued = []
        for fn in ("deposit", "withdraw", ""):
            for inv in sorted(RESCUED_VERIFIED.get(fn, set())):
                rescued.append(inv)

        rescued = _dedup_invariant_lines(rescued)

        rescued_vu, _rescued_vt = split_verified_into_useful_vs_trivial(
            rescued,
            fn_name="all",
        )

        merged.extend(rescued_vu)
    except Exception:
        logging.exception("[FLOW1] Failed to utility-filter RESCUED_VERIFIED; ignoring rescued bucket.")

    merged = _dedup_invariant_lines(merged)

    # ---------------------------------------------------------
    # Write authoritative merged files.
    # ---------------------------------------------------------
    all_path = os.path.join(FLOW1_VERIFIED_DIR, "verified_invariants.all.txt")

    with open(all_path, "w", encoding="utf-8") as f:
        f.write("# VERIFIED-USEFUL INVARIANTS ONLY\n")
        f.write("# UNKNOWN/TRUSTED/UNSOUND/REJECTED/TRIVIAL invariants are excluded.\n")
        for inv in merged:
            f.write(inv + "\n")

    with open(FLOW1_VERIFIED_FILE, "w", encoding="utf-8") as f:
        f.write("# VERIFIED-USEFUL INVARIANTS ONLY\n")
        f.write("# DEFAULT FLOW-2 INPUT. Fail-closed if empty.\n")
        for inv in merged:
            f.write(inv + "\n")

    # ---------------------------------------------------------
    # Machine-readable status for artifact evaluation.
    # ---------------------------------------------------------
    summary_path = os.path.join(FLOW1_VERIFIED_DIR, "flow1_status.json")

    with open(summary_path, "w", encoding="utf-8") as f:
        json.dump(
            {
                "verified_useful_count": len(merged),
                "flow2_invariant_guided_enabled": bool(merged),
                "verified_invariants_file": FLOW1_VERIFIED_FILE,
                "verified_invariants_all_file": all_path,
                "policy": (
                    "fail_closed: Flow-2 receives only verified-useful invariants; "
                    "unknown/trusted/unsound/rejected/trivial invariants are excluded"
                ),
            },
            f,
            indent=2,
        )

    if not merged:
        logging.warning(
            "[FLOW1] No verified-useful invariants produced. "
            "Flow-2 invariant-guided mode should be disabled."
        )

    return FLOW1_VERIFIED_FILE

def _sanitize_and_filter_invariants(
    raw_lines: List[str],
    allowed_arg_fields: Optional[set] = None,
) -> List[str]:
    """
    Normalize common LLM/Solidity aliases into InvGuard DSL, then apply strict filtering.

    ICSE-safe policy:
      - candidate invariants may be cleaned syntactically;
      - no semantic weakening is performed here;
      - raw malformed Solidity expressions are not passed to Z3;
      - state variables such as totalShares, feeBps, maxWithdrawBps, owner, shares are allowed;
      - unsupported constructs are dropped fail-closed.
    """

    def _parens_balanced(s: str) -> bool:
        return s.count("(") == s.count(")")

    def _repair_missing_parens(s: str) -> str:
        s = (s or "").strip()
        if not s:
            return s
        diff = s.count("(") - s.count(")")
        if diff > 0:
            s = s + (")" * diff)
        return s

    def _fix_bad_implication_guard(s: str) -> str:
        """
        Fix malformed implication guards:
          (meta.revert_taken == false -> X)
        into:
          ((meta.revert_taken == false) -> X)
        """
        s = (s or "").strip()
        if not s:
            return s

        s = s.replace("=>", "->")

        s = re.sub(
            r"^\(\s*meta\.revert_taken\s*==\s*(false|true)\s*->\s*",
            r"((meta.revert_taken == \1) -> ",
            s,
        )

        return s

    def _wrap_rhs_arith_in_parens(inv: str) -> str:
        """
        Add parentheses around simple arithmetic RHS when useful.
        This is syntax-only and does not change meaning.
        """
        s = (inv or "").strip()
        if not s:
            return s

        s = s.replace("=>", "->")

        if "->" in s:
            g, rhs = s.split("->", 1)
            g = g.strip()
            rhs = rhs.strip()
            rhs2 = _wrap_rhs_arith_in_parens(rhs)
            return f"{g} -> {rhs2}"

        m = re.match(r"^(.*?)(==|!=|>=|<=|>|<)\s*(.+)$", s)
        if not m:
            return s

        lhs, op, rhs = m.group(1).strip(), m.group(2), m.group(3).strip()

        if rhs.startswith("(") and rhs.endswith(")"):
            return s

        if re.search(r"\b(arg\.[A-Za-z_]\w*|meta\.value|meta\.contract_balance)\b", rhs) and re.search(r"[\+\-]", rhs):
            rhs = f"({rhs})"

        return f"{lhs} {op} {rhs}"

    def _normalize_mapping_reads(s: str) -> str:
        """
        Convert raw Solidity mapping reads into DSL select(...).

        Examples:
          shares[meta.sender]      -> select(shares, meta.sender)
          shares[msg.sender]       -> select(shares, meta.sender)
          balances[arg.to]         -> select(balances, arg.to)
        """
        s = (s or "").strip()
        if not s:
            return s

        map_pat = re.compile(r"\b([A-Za-z_][A-Za-z0-9_]*)\s*\[\s*([^\[\]]+?)\s*\]")

        prev = None
        while prev != s:
            prev = s

            def repl(m: re.Match) -> str:
                base = m.group(1).strip()
                key = m.group(2).strip()
                key = re.sub(r"\bmsg\.sender\b", "meta.sender", key)
                key = re.sub(r"\btx\.origin\b", "meta.sender", key)
                return f"select({base}, {key})"

            s = map_pat.sub(repl, s)

        return s

    def _strip_balanced_outer_parens_once(s: str) -> str:
        """
        Remove one pair of outer parentheses only if they wrap the whole expression.
        """
        s = (s or "").strip()
        if not (s.startswith("(") and s.endswith(")")):
            return s

        depth = 0
        for i, ch in enumerate(s):
            if ch == "(":
                depth += 1
            elif ch == ")":
                depth -= 1
                if depth == 0 and i != len(s) - 1:
                    return s
            if depth < 0:
                return s

        return s[1:-1].strip()

    def sanitize(inv: str) -> str:
        s = inv or ""

        # ------------------------------------------------------------
        # Normalize Solidity aliases.
        # ------------------------------------------------------------
        s = re.sub(r"\bmsg\.sender\b", "meta.sender", s)
        s = re.sub(r"\bmsg\.value\b", "meta.value", s)
        s = re.sub(r"\btx\.origin\b", "meta.sender", s)
        s = re.sub(r"\btx\.sender\b", "meta.sender", s)
        s = re.sub(r"\btx\.value\b", "meta.value", s)

        s = re.sub(r"\b(pre|post)\.message\.value\b", "meta.value", s)
        s = re.sub(r"\bmessage\.value\b", "meta.value", s)
        s = re.sub(r"\b(pre|post)\.message\.sender\b", "meta.sender", s)
        s = re.sub(r"\bmessage\.sender\b", "meta.sender", s)

        # address(this).balance -> meta.contract_balance
        s = re.sub(
            r"\baddress\s*\(\s*this\s*\)\s*\.balance\b",
            "meta.contract_balance",
            s,
        )
        s = re.sub(r"\bthis\.balance\b", "meta.contract_balance", s)

        # Normalize pre_/post_ prefixes.
        s = re.sub(r"\bpost_", "post.", s)
        s = re.sub(r"\bpre_", "pre.", s)

        # Normalize arg nesting artifacts.
        s = re.sub(r"\barg\.arg\.", "arg.", s)
        s = re.sub(r"\b(post|pre)\.arg\.", "arg.", s)
        s = re.sub(r"\b(post|pre)\.arg\.arg\.", "arg.", s)

        # Normalize sender/value under wrong namespaces.
        s = re.sub(r"\bpre\.sender\b", "meta.sender", s)
        s = re.sub(r"\bpost\.sender\b", "meta.sender", s)
        s = re.sub(r"\barg\.sender\b", "meta.sender", s)

        s = re.sub(r"\bpre\.value\b", "meta.value", s)
        s = re.sub(r"\bpost\.value\b", "meta.value", s)
        s = re.sub(r"\barg\.value\b", "meta.value", s)

        s = re.sub(r"\bmeta\.(val|amount|msg_value)\b", "meta.value", s)
        s = re.sub(r"\bmeta\.(from|msg_sender)\b", "meta.sender", s)

        # Some LLM outputs incorrectly refer to meta.owner.
        s = re.sub(r"\bmeta\.owner\b", "pre.owner", s)

        # Remove accidental pre.meta/post.meta.
        s = re.sub(r"\bpre\.meta\.", "meta.", s)
        s = re.sub(r"\bpost\.meta\.", "meta.", s)

        # Convert mapping syntax into select(...).
        s = _normalize_mapping_reads(s)

        s = s.strip()
        s = _fix_bad_implication_guard(s)
        s = _repair_missing_parens(s)

        # Strip one harmless whole-expression wrapper if useful.
        # Keep repeating only while safe.
        prev = None
        while prev != s:
            prev = s
            s = _strip_balanced_outer_parens_once(s)

        s = _wrap_rhs_arith_in_parens(s)

        # Drop unsupported constructs.
        low_no_space = s.replace(" ", "").lower()

        if "store(" in low_no_space:
            return ""

        if "abs(" in low_no_space:
            return ""

        if re.search(r"\barg\.meta\.", s):
            return ""

        if not _parens_balanced(s):
            return ""

        return s

    sanitized = [sanitize(ln) for ln in (raw_lines or []) if ln and ln.strip()]
    sanitized = [ln for ln in sanitized if ln]

    # ------------------------------------------------------------
    # Meta whitelist.
    # ------------------------------------------------------------
    ALLOWED_META = {
        "sender",
        "value",
        "revert_taken",
        "contract_balance",
        "this_balance",
    }
    META_FIELD_RE = re.compile(r"\bmeta\.([A-Za-z_]\w*)\b")

    def meta_fields_ok(s: str) -> bool:
        fields = META_FIELD_RE.findall(s)
        return all(f in ALLOWED_META for f in fields)

    sanitized = [ln for ln in sanitized if meta_fields_ok(ln)]

    # ------------------------------------------------------------
    # Optional arg whitelist.
    # ------------------------------------------------------------
    ARG_FIELD_RE = re.compile(r"\barg\.([A-Za-z_]\w*)\b")

    def arg_fields_ok(s: str) -> bool:
        if not allowed_arg_fields:
            return True
        fields = ARG_FIELD_RE.findall(s)
        return all(f in allowed_arg_fields for f in fields)

    sanitized = [ln for ln in sanitized if arg_fields_ok(ln)]

    # ------------------------------------------------------------
    # DSL sanity filtering.
    # ------------------------------------------------------------
    DSL_PATTERN = re.compile(r"\b(pre|post|meta|arg)\.", re.IGNORECASE)

    ALLOWED_FUNS = {"select", "ite"}
    ALLOWED_WORDS = {
        "and",
        "or",
        "not",
        "implies",
        "true",
        "false",
    }

    # State variables that may appear without pre./post. in candidate invariants.
    # These are allowed as current-state symbols and compiled by the checker/model.
    ALLOWED_BARE_STATE = {
        "shares",
        "balances",
        "allowance",
        "allowances",
        "totalShares",
        "totalSupply",
        "feeBps",
        "maxWithdrawBps",
        "owner",
        "price",
        "collateral",
        "payout",
        "fee",
        "sendAmt",
        "minted",
        "prevBal",
        "ok",
    }

    WORD_TOKEN = re.compile(r"[A-Za-z_][A-Za-z0-9_\.]*")

    def is_dsl_like(inv: str) -> bool:
        s = inv.strip()
        if not s:
            return False

        if not DSL_PATTERN.search(s):
            return False

        low = s.lower()

        if "for all" in low or "forall" in low or "exists" in low:
            return False

        if not any(op in s for op in ["==", "!=", ">=", "<=", ">", "<", "->", "=>", "select(", "ite("]):
            return False

        # Operator whitelist (grammar gate): the InvGuard DSL permits only
        # == != >= <= > <  (comparison),  + - * /  (arithmetic),
        # && || ->  (logic/implication). Any other operator-like symbol
        # (%, **, ^, bitwise, shifts, ternary ?:) is outside the grammar and the
        # line is rejected. This makes operator conformance an explicit acceptance
        # check rather than something we merely ask the LLM to obey in the prompt.
        # NB: test banned multi-char operators FIRST, before single-char stripping
        # collapses e.g. "**" into spaces.
        if re.search(r"\*\*|<<|>>", s):
            return False
        _op_scrubbed = s
        for _allowed in ("==", "!=", ">=", "<=", "->", "=>", "&&", "||",
                         ">", "<", "+", "-", "*", "/", "="):
            _op_scrubbed = _op_scrubbed.replace(_allowed, " ")
        if re.search(r"[%\^~?:]", _op_scrubbed):
            return False

        for tok in WORD_TOKEN.findall(s):
            t = tok.strip()
            tl = t.lower()

            # Namespaced symbols.
            if t.startswith(("pre.", "post.", "meta.", "arg.")):
                continue

            # Function names / boolean words.
            if tl in ALLOWED_WORDS:
                continue

            if t in ALLOWED_FUNS:
                continue

            # Bare state/local variables.
            if t in ALLOWED_BARE_STATE:
                continue

            # Solidity literal-ish leftovers are not okay.
            return False

        return True

    all_lines = [ln for ln in sanitized if is_dsl_like(ln)]

    # ------------------------------------------------------------
    # Drop unsupported external-call tokens.
    # ------------------------------------------------------------
    BANNED_TOKENS = (
        "selfdestruct",
        "payable(",
        "delegatecall",
        "staticcall",
        "call(",
        "call.value",
    )

    def is_supported(line: str) -> bool:
        low = line.replace(" ", "").lower()
        return not any(tok in low for tok in BANNED_TOKENS)

    all_lines = [ln for ln in all_lines if is_supported(ln)]

    # ------------------------------------------------------------
    # Mappings must use select(...), not raw mapping syntax.
    # ------------------------------------------------------------
    def _drops_raw_mapping_compare(s: str) -> bool:
        low = s.replace(" ", "").lower()

        raw_mapping_names = [
            "pre.balances",
            "post.balances",
            "pre.shares",
            "post.shares",
            "balances[",
            "shares[",
        ]

        if any(x in low for x in raw_mapping_names):
            if not any(x in low for x in (
                "select(pre.balances",
                "select(post.balances",
                "select(pre.shares",
                "select(post.shares",
                "select(balances",
                "select(shares",
            )):
                return True

        return False

    all_lines = [ln for ln in all_lines if not _drops_raw_mapping_compare(ln)]

    # ------------------------------------------------------------
    # Drop known-useless / unstable patterns.
    # ------------------------------------------------------------
    def _drops_semantically_useless(inv: str) -> bool:
        low = inv.replace(" ", "").lower()

        if "select(post." in low and "<=" in low and "+select(pre." in low:
            return True

        if "select(post." in low and "!=select(pre." in low:
            return True

        return False

    all_lines = [ln for ln in all_lines if not _drops_semantically_useless(ln)]

    # Stable de-dup.
    out: List[str] = []
    seen = set()

    for ln in all_lines:
        s = (ln or "").strip()
        if not s:
            continue

        key = re.sub(r"\s+", " ", s)

        if key in seen:
            continue

        seen.add(key)
        out.append(s)

    return out

def _split_dep_withdraw(lines: List[str]) -> (List[str], List[str]):
    def has_meta_value(s: str) -> bool:
        return "meta.value" in s.lower()

    def has_arg_any(s: str) -> bool:
        return re.search(r"\barg\.", s, flags=re.I) is not None

    deposit_invs, withdraw_invs, neutral_invs = [], [], []
    for inv in lines:
        mv = has_meta_value(inv)
        aa = has_arg_any(inv)
        if mv and not aa:
            deposit_invs.append(inv)
        elif aa and not mv:
            withdraw_invs.append(inv)
        elif not mv and not aa:
            neutral_invs.append(inv)
        else:
            withdraw_invs.append(inv)

    dep_lines = [x for x in (deposit_invs + neutral_invs) if not has_arg_any(x)]
    wdr_lines = withdraw_invs + neutral_invs
    return dep_lines, wdr_lines

from typing import Iterable  # add near imports if not already present


def _extract_counterexample_bindings(failed_item: dict) -> dict:
    """
    Normalize bindings payload from a failed invariant item produced by InvGuard.
    Handles: {"model": {...}} or {"model_slice": {...}} or missing.
    Returns a dict (possibly empty).
    """
    if not isinstance(failed_item, dict):
        return {}
    m = failed_item.get("model")
    if isinstance(m, dict):
        return m
    ms = failed_item.get("model_slice")
    if isinstance(ms, dict):
        return ms
    return {}


def _extract_failed_invariant_lines(
    failed_items: list[dict],
    *,
    dedup: bool = True,
    repair_parens: bool = True,
) -> list[str]:
    """
    Extract failed invariant 'line' strings safely + optionally deduplicate.
    Normalizes '=>' to '->' to match your pipeline.

    This replaces the repeated local helper logic inside:
      - z3_checker_tool()
      - _run_checker_once_from_python()
    """

    def _repair_missing_parens_local(s: str) -> str:
        s = (s or "").strip()
        if not s:
            return s
        diff = s.count("(") - s.count(")")
        if diff > 0:
            s = s + (")" * diff)
        return s

    out: list[str] = []
    seen: set[str] = set()

    for it in failed_items or []:
        if not isinstance(it, dict):
            continue
        line = (it.get("line") or "").strip()
        if not line:
            continue
        line = line.replace("=>", "->").strip()
        if repair_parens:
            line = _repair_missing_parens_local(line)

        if dedup:
            key = re.sub(r"\s+", " ", line).strip()
            if key in seen:
                continue
            seen.add(key)

        out.append(line)

    return out

