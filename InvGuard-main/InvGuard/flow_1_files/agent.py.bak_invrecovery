async def main():
    logging.basicConfig(level=logging.INFO)

    # -------------------------------------------------------
    # Clean stale artifacts from previous runs.
    # This prevents old results (wrong contracts, UNSOUND files,
    # stale invariants from months-old runs) from contaminating
    # the current run's outputs.
    # -------------------------------------------------------
    import shutil as _shutil

    _flow1_dirs_to_clear = [
        BASE_EXECUTION_DIR,          # run_outputs/flow1/
        FLOW1_VERIFIED_DIR,          # run_outputs/flow1_verified_invariants/
    ]
    for _d in _flow1_dirs_to_clear:
        if os.path.exists(_d):
            try:
                _shutil.rmtree(_d)
                logging.info(f"[cleanup] Cleared stale dir: {_d}")
            except Exception as _e:
                logging.warning(f"[cleanup] Could not clear {_d}: {_e}")
        os.makedirs(_d, exist_ok=True)

    # Also clear attack targets dir
    _atk_dir = os.path.join(REPO_ROOT, "run_outputs", "flow1_attack_targets")
    if os.path.exists(_atk_dir):
        try:
            _shutil.rmtree(_atk_dir)
        except Exception:
            pass
    os.makedirs(_atk_dir, exist_ok=True)

    contract_on_disk = _find_contract_on_disk()
    print("[DEBUG] contract_on_disk =", contract_on_disk)
    if not contract_on_disk:
        raise FileNotFoundError("No Solidity contract found.")

    _load_contract_to_base(contract_on_disk, "contract.sol")
    contract_path = os.path.join(BASE_EXECUTION_DIR, "contract.sol")
    with open(contract_path, "r", encoding="utf-8") as f:
        contract_source_text = f.read()

    # -------------------------------------------------------
    # Extract contract structure to make LLM prompt contract-aware.
    # This prevents hallucinated variable names for unfamiliar contracts.
    # -------------------------------------------------------
    def _extract_contract_structure(src: str) -> str:
        """Extract state vars, mappings, and function signatures for the prompt."""
        clean = re.sub(r"//.*?$", "", src, flags=re.M)
        clean = re.sub(r"/\*.*?\*/", "", clean, flags=re.S)

        # State variables (uint, address, bool, mapping)
        state_vars = re.findall(
            r"(?:uint\d*|int\d*|address|bool|bytes\d*)\s+(?:public|private|internal)?\s*(\w+)\s*[=;]",
            clean
        )
        # Mappings
        mappings = re.findall(
            r"mapping\s*\([^)]+\)\s+(?:public|private|internal)?\s*(\w+)\s*[=;]",
            clean
        )
        # Public functions and their parameters
        fns = re.findall(
            r"function\s+(\w+)\s*\(([^)]*)\)\s*([^{]*)",
            clean
        )

        lines = []
        if state_vars:
            lines.append(f"State variables: {', '.join(dict.fromkeys(state_vars))}")
        if mappings:
            lines.append(f"Mappings: {', '.join(dict.fromkeys(mappings))}")
        if fns:
            fn_descs = []
            for fn_entry in fns[:8]:  # cap at 8 functions
                name = fn_entry[0]
                params = fn_entry[1]
                param_types = [p.strip().split()[0] for p in params.split(",") if p.strip()]
                fn_descs.append(f"{name}({', '.join(param_types)})")
            lines.append(f"Functions: {', '.join(fn_descs)}")
        return "\n".join(lines)

    _contract_structure = _extract_contract_structure(contract_source_text)

    user_query = dedent(f"""
        Please analyze the following Solidity smart contract and generate invariants for it.

        CONTRACT STRUCTURE (use EXACTLY these variable names in invariants):
        {_contract_structure}

        CRITICAL: Only reference variable names listed above. Do NOT invent names like
        totalSupply, balances, or ShareVault if they don't appear in the contract.
        Use the exact mapping names (e.g. collateral, debt, shares) as shown above.

        ```solidity
        {contract_source_text}
        ```
    """)

    ctx = AgentContext(user_query=user_query)

    # ----------------------------------------------------
    # 1) Run LLM orchestration (generation + tool calls)
    #
    # RELIABILITY (agent layer): the agentic orchestration is best-effort. We do
    # NOT assume it succeeded — we catch any failure, then explicitly check
    # whether it produced the artifacts the deterministic pipeline needs
    # (contract.sol, invariants.txt). The deterministic run that follows is the
    # authoritative path; here we make the agent→fallback relationship OBSERVABLE
    # (logged) instead of silent, so the system's behaviour is auditable.
    # ----------------------------------------------------
    _agent_ok = False
    try:
        _agent_result = await Runner.run(
            orchestrator_agent, user_query, context=ctx, max_turns=40
        )
        _agent_ok = True
        logging.info("[FLOW1] orchestrator agent run completed (turns<=40).")
    except Exception as _agent_exc:
        logging.warning(
            "[FLOW1] orchestrator agent run failed (%s); the deterministic "
            "pipeline below will proceed and is authoritative.", _agent_exc
        )

    # Did the agent path actually deliver the expected artifacts?
    def _artifact_present(fname: str) -> bool:
        try:
            p = os.path.join(BASE_EXECUTION_DIR, fname)
            return os.path.exists(p) and os.path.getsize(p) > 0
        except Exception:
            return False

    _have_contract = _artifact_present("contract.sol")
    _have_invs = _artifact_present("invariants.txt")
    if _agent_ok and _have_contract and _have_invs:
        logging.info("[FLOW1] agent path produced contract.sol + invariants.txt.")
    else:
        logging.info(
            "[FLOW1] agent path incomplete (contract=%s, invariants=%s); "
            "deterministic generation will supply/repair them.",
            _have_contract, _have_invs,
        )

    # ----------------------------------------------------
    # ✅ REQUIRED (soundness): define mapping vars for mapping-aware refinement discard rules
    # Do this BEFORE any refinement stages.
    # ----------------------------------------------------
    try:
        globals()["MAPPING_VARS"] = set()

        src = contract_source_text
        src = re.sub(r"//.*?$", "", src, flags=re.M)
        src = re.sub(r"/\*.*?\*/", "", src, flags=re.S)

        # mapping(address => uint256) public balances;
        for m in re.finditer(
            r"\bmapping\s*\([^)]*\)\s*(?:public|private|internal|external)?\s*([A-Za-z_]\w*)\s*;",
            src,
        ):
            globals()["MAPPING_VARS"].add(m.group(1))

        # mapping(...) name; (covers cases w/ modifiers/spacing)
        for m in re.finditer(r"\bmapping\s*\([^)]*\)\s*([A-Za-z_]\w*)\s*;", src):
            globals()["MAPPING_VARS"].add(m.group(1))
    except Exception:
        globals()["MAPPING_VARS"] = set()

    # ----------------------------------------------------
    # 2) ALWAYS run deterministic checker (deposit + withdraw)
    # ----------------------------------------------------
    logging.info("[FLOW1] Forcing deterministic Z3 checks (deposit + withdraw).")

    # FLOW1_FUNCTIONS env var allows overriding the default deposit/withdraw pair.
    # Format: "funcA,funcB"  e.g. FLOW1_FUNCTIONS="addCollateral,borrow"
    _flow1_fns = os.environ.get("FLOW1_FUNCTIONS", "deposit,withdraw").strip()
    _fn_parts = [f.strip() for f in _flow1_fns.split(",") if f.strip()]
    _fn1 = _fn_parts[0] if len(_fn_parts) > 0 else "deposit"
    _fn2 = _fn_parts[1] if len(_fn_parts) > 1 else "withdraw"

    res_dep = _run_checker_once_from_python(function_name=_fn1)
    res_wdr = _run_checker_once_from_python(function_name=_fn2)

    # ----------------------------------------------------
    # ✅ REQUIRED: split INFRA failure vs UNSOUND modeling
    #
    # ✅ UPDATED REQUIRED CHANGE (align with new structured UNSOUND signaling):
    #   - Infra failure ONLY if returncode != 0 (or res is None).
    #   - UNSOUND detection MUST prefer structured field:
    #         res.unsound_invariants
    #     and only fall back to report substring markers if needed.
    #   - If UNSOUND: fail-closed (no refinement, no strength scoring).
    #
    # ✅ CHANGE C/G APPLIED HERE:
    #   - _checker_unsound now delegates to helper E: _checker_unsound_result(res)
    # ----------------------------------------------------
    def _checker_infra_failed(res) -> bool:
        """
        True only when the checker did not run correctly (crash / non-zero exit).
        DO NOT treat UNSOUND as infra failure.
        """
        if res is None:
            return True
        return getattr(res, "returncode", 0) != 0

    def _checker_unsound(res) -> bool:
        return _checker_unsound_result(res)

    # Optional legacy path check (only if your adapter still writes them somewhere)
    def _unsound_file_has_content(p: str) -> bool:
        """
        Returns True only for STRUCTURAL unsoundness (body not modeled).
        Z3CHECKER_TIMEOUT is a solver resource issue, NOT a model soundness issue.
        When the parser produced a valid body (Slither path), a timeout means
        the invariant was too complex for the budget, not that the model is wrong.
        """
        if not os.path.exists(p):
            return False
        try:
            with open(p, "r", encoding="utf-8") as f:
                content_lines = f.readlines()
            for ln in content_lines:
                s = ln.strip()
                if not s or s.startswith("#"):
                    continue
                # Solver timeout is a resource issue, not structural unsoundness.
                # Treat it as "excluded" (UNKNOWN bucket) not "model is wrong".
                if "Z3CHECKER_TIMEOUT" in s or "solver-timeout" in s.lower():
                    continue
                # Genuine structural unsoundness: body not modeled, UNSOUND_MODEL flag, etc.
                return True
            return False
        except Exception:
            return True

    # ----------------------------------------------------
    # 2.A) INFRA failure: abort immediately
    # ----------------------------------------------------
    if _checker_infra_failed(res_dep) or _checker_infra_failed(res_wdr):
        print("[FLOW1] ❌ Skipping refinement + strength scoring due to checker infrastructure failure (non-zero exit).")
        return

    # ----------------------------------------------------
    # 2.B) UNSOUND modeling: fail-closed (but NOT infra failure)
    #
    # ✅ UPDATED REQUIRED CHANGE:
    #   - prefer structured UNSOUND detection from results (via helper E)
    #   - keep legacy file checks as optional extra safety net
    #
    # Note on naming/path:
    #   - adapter: BASE_EXECUTION_DIR/verified_invariants.<fn>.unsound.txt
    #   - tool/taxonomy: FLOW1_VERIFIED_DIR/invariants.<fn>.UNSOUND.txt
    #   These can coexist; structured detection is primary.
    # ----------------------------------------------------
    unsound_dep_path = os.path.join(BASE_EXECUTION_DIR, "verified_invariants.deposit.unsound.txt")
    unsound_wdr_path = os.path.join(BASE_EXECUTION_DIR, "verified_invariants.withdraw.unsound.txt")

    if (
        _checker_unsound(res_dep)
        or _checker_unsound(res_wdr)
        or _unsound_file_has_content(unsound_dep_path)
        or _unsound_file_has_content(unsound_wdr_path)
    ):
        globals()["UNSOUND_MODEL"] = True
        print("[FLOW1] ⚠️ Checker ran successfully, but model was UNSOUND (UNVERIFIED_UNSOUND).")
        print("[FLOW1] ⚠️ Refusing refinement + strength scoring to avoid unsound verification claims.")

        try:
            dep_u = getattr(res_dep, "unsound_invariants", []) or []
            wdr_u = getattr(res_wdr, "unsound_invariants", []) or []
            if dep_u or wdr_u:
                print(f"[FLOW1] UNSOUND attempted invariants (structured): deposit={len(dep_u)} withdraw={len(wdr_u)}")
        except Exception:
            pass

        print(f"[FLOW1] Legacy UNSOUND files (if present):\n  - {unsound_dep_path}\n  - {unsound_wdr_path}")

        # Still emit attack objectives. These are not verification claims.
        try:
            attack_targets_path = _write_flow1_attack_targets(contract_source_text)
            print(f"[FLOW1] ✅ Security obligations / attack objectives written despite Z3 UNSOUND:\n  {attack_targets_path}")
        except Exception:
            logging.exception("[FLOW1] Failed to write security obligations / attack objectives after UNSOUND result.")

        # Also finalize whatever verified-useful invariants exist, possibly empty.
        try:
            out_path = _finalize_flow2_invariants()
            print(f"[FLOW1] ✅ Final verified-useful invariant file written to:\n  {out_path}")
        except Exception:
            logging.exception("[FLOW1] Failed to finalize verified-useful invariant file after UNSOUND result.")

        return

    globals()["UNSOUND_MODEL"] = False

    # ----------------------------------------------------
    # Shared meaningfulness heuristic (for VM filtering + taxonomy)
    # ----------------------------------------------------
    def _looks_meaningful(inv: str) -> bool:
        s = (inv or "").strip()
        if not s:
            return False

        # AC_MEANINGFUL_V2: authorization predicates are meaningful even
        # without pre/post state (access-control security obligations).
        _low_ac = s.lower()
        if (any(_t in _low_ac for _t in ('meta.sender','msg.sender','tx.origin',
                'owner','admin','role','authorized','creator','governance'))
            and any(_op in s for _op in ('==','!=','>=','<=','<','>'))):
            return True
        s0 = s.replace(" ", "")
        m = re.match(r"^(.*?)(==|>=|<=)(.*?)$", s0)
        if m and m.group(1) == m.group(3):
            return False
        low = s.lower()
        has_state = ("pre." in low) or ("post." in low) or ("select(pre." in low) or ("select(post." in low)
        has_relation = ("pre." in low and "post." in low) or ("select(pre." in low and "select(post." in low)
        has_amount_value = ("arg." in low) or ("meta.value" in low)
        has_ownerish = ("owner" in low and ("pre." in low or "post." in low))
        return bool(has_relation or (has_state and (has_amount_value or has_ownerish)))

    # ----------------------------------------------------
    # ✅ REQUIRED: deterministic merged taxonomy emit (ALL)
    # Place immediately after successful deterministic runs.
    # ----------------------------------------------------
    try:
        _emit_taxonomy_outputs(
            fn_tag="all",
            fn_name_for_scoring="all",
            verified=(res_dep.verified_invariants or []) + (res_wdr.verified_invariants or []),
            failed_items=(res_dep.failed_invariants or []) + (res_wdr.failed_invariants or []),
            trusted=[],  # UNKNOWN/TRUSTED excluded from Flow-2
            looks_meaningful_fn=_looks_meaningful,
        )
    except Exception:
        logging.exception("[FLOW1] Failed deterministic merged taxonomy emit (continuing).")

    if getattr(res_dep, "report", ""):
        print("\n[FLOW1] Deposit checker report (tail):")
        print("\n".join((res_dep.report or "").splitlines()[-40:]))

    if getattr(res_wdr, "report", ""):
        print("\n[FLOW1] Withdraw checker report (tail):")
        print("\n".join((res_wdr.report or "").splitlines()[-40:]))

    # ----------------------------------------------------
    # 3) Counterexample-aware TEMPLATE rewrite → deterministic refinement
    #    ✅ REQUIRED pipeline ordering:
    #      Z3 fails -> _apply_template_rewrites -> Z3 -> if still failing -> deterministic_refine_invariants
    #    🚫 No direct free-form LLM rewriting here.
    # ----------------------------------------------------
    for fn_name, res in [(_fn1, res_dep), (_fn2, res_wdr)]:
        if not (res and res.failed_invariants):
            continue

        logging.info(f"[FLOW1] Failed invariants detected for {fn_name} — refining.")

        forced_input = f"invariants.forced.{fn_name}.filtered.txt"

        # ============================================================
        # 3.A Counterexample-guided TEMPLATE rewrite (Reviewer Point 4)
        # ============================================================
        rewritten_lines = _apply_template_rewrites(
            failed_items=res.failed_invariants,
            fn_name=fn_name,
        )

        if rewritten_lines:
            rewritten_dep, rewritten_wdr = _split_dep_withdraw(rewritten_lines)
            chosen_rewritten = rewritten_dep if fn_name == _fn1 else rewritten_wdr

            if chosen_rewritten:
                # ✅ FINAL PASS REPAIR before writing rewritten checker input
                chosen_rewritten = _final_repair_invariant_lines(chosen_rewritten)

                rewritten_path = os.path.join(
                    BASE_EXECUTION_DIR,
                    f"invariants.forced.{fn_name}.rewritten.filtered.txt",
                )
                with open(rewritten_path, "w", encoding="utf-8") as f:
                    f.write("\n".join(chosen_rewritten) + "\n")

                _assert_nonempty_invariant_file(
                    rewritten_path,
                    f"rewrite-stage:{fn_name}",
                )

                core_rw: InvGuardResult = run_invguard_core(
                    z3checker_root=os.path.join(THIS_DIR, "Z3Checker"),
                    contract_path=contract_path,
                    invariants_txt_path=rewritten_path,
                    function_name=fn_name,
                )

                # 🔒 Rescue verified invariants from rewrite stage
                for v in (core_rw.verified or []):
                    RESCUED_VERIFIED[fn_name].add(v)

                # ✅ Emit taxonomy for rewrite-stage results as well
                try:
                    _emit_taxonomy_outputs(
                        fn_tag=f"{fn_name}.rewrite",
                        fn_name_for_scoring=fn_name,
                        verified=core_rw.verified or [],
                        failed_items=core_rw.failed or [],
                        trusted=[],  # UNKNOWN/TRUSTED excluded from Flow-2
                        looks_meaningful_fn=_looks_meaningful,
                    )
                except Exception:
                    logging.exception(f"[FLOW1] Failed taxonomy emit for {fn_name} rewrite-stage (continuing).")

                # If rewrite stage fully fixed: done for this fn
                if not (core_rw.failed or []):
                    logging.info(f"[FLOW1] ✅ Template rewrite fixed all failed invariants for {fn_name}.")
                    continue

                logging.info(
                    f"[FLOW1] Template rewrite insufficient for {fn_name}; "
                    f"falling back to deterministic refinement."
                )

        # ============================================================
        # 3.B Deterministic refinement (guard-first, weaken-second)
        # ============================================================
        refined_filename = deterministic_refine_invariants(
            failed_invariants_json=json.dumps(res.failed_invariants),
            original_invariants_filename=forced_input,
            refined_invariants_filename=f"invariants.forced.{fn_name}.refined.filtered.txt",
        )

        try:
            refined_path = os.path.join(BASE_EXECUTION_DIR, refined_filename)
            with open(refined_path, "r", encoding="utf-8") as f:
                refined_raw = [ln.strip() for ln in f if ln.strip()]

            refined_all = _sanitize_and_filter_invariants(refined_raw)
            refined_dep, refined_wdr = _split_dep_withdraw(refined_all)

            chosen = refined_dep if fn_name == _fn1 else refined_wdr

            # ✅ REQUIRED: do NOT inject tautology fallback (meta.sender==meta.sender).
            # If nothing remains, we just skip this stage gracefully.
            if not chosen:
                logging.info(f"[FLOW1] No usable refined invariants produced for {fn_name}; skipping refined re-check.")
                continue

            # ✅ FINAL PASS REPAIR before writing refined checker input
            chosen = _final_repair_invariant_lines(chosen)

            # Keep parser-safe candidates only.
            # Do NOT restrict to feeBps/maxWithdrawBps here; that deletes real accounting invariants.
            chosen = [
                x for x in chosen
                if _is_simple_z3_candidate(x)
                and _is_real_verified_invariant_line(x)
            ]

            # If repair/sanitize removed everything, skip (no tautology fallback).
            if not chosen:
                logging.info(
                    f"[FLOW1] Refined invariants became empty after repair for {fn_name}; skipping refined re-check."
                )
                continue

            forced_refined_path = os.path.join(
                BASE_EXECUTION_DIR,
                f"invariants.forced.{fn_name}.refined.filtered.txt",
            )
            with open(forced_refined_path, "w", encoding="utf-8") as f:
                f.write("\n".join(chosen) + "\n")

            _assert_nonempty_invariant_file(
                forced_refined_path,
                f"refined-stage:{fn_name}",
            )

            core2: InvGuardResult = run_invguard_core(
                z3checker_root=os.path.join(THIS_DIR, "Z3Checker"),
                contract_path=contract_path,
                invariants_txt_path=forced_refined_path,
                function_name=fn_name,
            )

            # 🔒 Rescue verified invariants from deterministic refinement stage
            for v in (core2.verified or []):
                RESCUED_VERIFIED[fn_name].add(v)

            # ✅ Emit taxonomy for refinement-stage results
            try:
                _emit_taxonomy_outputs(
                    fn_tag=f"{fn_name}.refined",
                    fn_name_for_scoring=fn_name,
                    verified=core2.verified or [],
                    failed_items=core2.failed or [],
                    trusted=[],  # UNKNOWN/TRUSTED excluded from Flow-2
                    looks_meaningful_fn=_looks_meaningful,
                )
            except Exception:
                logging.exception(f"[FLOW1] Failed taxonomy emit for {fn_name} refined-stage (continuing).")

            report2 = "\n".join(core2.report_lines or [])
            if report2.strip():
                print(f"\n[FLOW1] Checker report after refinement ({fn_name}, tail):")
                print("\n".join(report2.splitlines()[-40:]))

        except Exception as e:
            logging.exception(f"[FLOW1] Checker failed on refined invariants ({fn_name}).")
            print(f"\n[FLOW1] Refined checker failed ({fn_name}): {e}")

    # ----------------------------------------------------
    # NEW: merged summary JSON from the already-written all-buckets (best-effort)
    # ----------------------------------------------------
    try:
        def _read_bucket(p: str) -> List[str]:
            if not os.path.exists(p):
                return []
            out = []
            with open(p, "r", encoding="utf-8") as f:
                for ln in f:
                    ln = ln.strip()
                    if ln and not ln.startswith("#"):
                        out.append(ln)
            return out

        buckets = {
            "VU": _read_bucket(os.path.join(FLOW1_VERIFIED_DIR, "invariants.all.VU.txt")),
            "VT": _read_bucket(os.path.join(FLOW1_VERIFIED_DIR, "invariants.all.VT.txt")),
            "VM": _read_bucket(os.path.join(FLOW1_VERIFIED_DIR, "invariants.all.VM.txt")),
            "UT": _read_bucket(os.path.join(FLOW1_VERIFIED_DIR, "invariants.all.UT.txt")),
        }
        _write_taxonomy_summary_json(
            os.path.join(FLOW1_VERIFIED_DIR, "invariant_summary.json"),
            buckets,
        )
    except Exception:
        logging.exception("[FLOW1] Failed to write invariant_summary.json (continuing).")


    # ----------------------------------------------------
    # 3.C) Emit security obligations / attack objectives for Flow-2.
    # These are separate from verified invariants.
    # ----------------------------------------------------
    try:
        attack_targets_path = _write_flow1_attack_targets(contract_source_text)
        print(f"[FLOW1] ✅ Security obligations / attack objectives written to:\n  {attack_targets_path}")
    except Exception:
        logging.exception("[FLOW1] Failed to write security obligations / attack objectives.")
    
    # ----------------------------------------------------
    # 4) Finalize merged invariants for Flow-2
    #    ✅ REQUIRED: Flow-2 must consume only VERIFIED-USEFUL (preferably STRONG) invariants.
    # ----------------------------------------------------
    # -------------------------------------------------------
    # Direct VU file injection from RESCUED_VERIFIED.
    # This ensures the share-accounting invariants verified by Z3
    # are always present in the VU files, regardless of taxonomy merge issues.
    # RESCUED_VERIFIED accumulates every invariant confirmed HOLDS by the adapter.
    # -------------------------------------------------------
    try:
        _all_rescued: List[str] = []
        for fn_key in ("deposit", "withdraw", ""):
            for inv in sorted(RESCUED_VERIFIED.get(fn_key, set())):
                if inv and _is_real_verified_invariant_line(inv):
                    _all_rescued.append(inv)
        _all_rescued = _dedup_invariant_lines(_all_rescued)

        if _all_rescued:
            # Write directly into the VU files (append-safe: overwrite is fine since
            # _finalize_flow2_invariants already ran and these are always a superset).
            _rescued_vu, _ = split_verified_into_useful_vs_trivial(_all_rescued, fn_name="all")
            _rescued_dep_vu, _ = split_verified_into_useful_vs_trivial(
                [v for v in _all_rescued if "totalshares" in v.lower() or "select(post.shares" in v.lower() or "select(pre.shares" in v.lower()],
                fn_name="deposit"
            )
            _rescued_wdr_vu, _ = split_verified_into_useful_vs_trivial(
                [v for v in _all_rescued if "totalshares" in v.lower() or "select(post.shares" in v.lower() or "select(pre.shares" in v.lower()],
                fn_name="withdraw"
            )

            # Merge with existing VU file content (don't lose feeBps etc.)
            def _merge_vu(path, new_invs):
                existing = []
                if os.path.exists(path):
                    with open(path) as _f:
                        existing = [l.strip() for l in _f if l.strip() and not l.strip().startswith("#")]
                merged = _dedup_invariant_lines(existing + new_invs)
                _write_taxonomy_bucket(path, "# VERIFIED-USEFUL (constraints for Flow-2)", merged)

            _merge_vu(os.path.join(FLOW1_VERIFIED_DIR, "invariants.all.VU.txt"), _rescued_vu)
            # Always write canonical deposit/withdraw files for backward compat
            _merge_vu(os.path.join(FLOW1_VERIFIED_DIR, "invariants.deposit.VU.txt"), [
                v for v in _rescued_vu if ">=" in v and ("totalshares" in v.lower() or "shares" in v.lower() or "collateral" in v.lower())
            ])
            _merge_vu(os.path.join(FLOW1_VERIFIED_DIR, "invariants.withdraw.VU.txt"), [
                v for v in _rescued_vu if "<=" in v and ("totalshares" in v.lower() or "shares" in v.lower() or "debt" in v.lower())
            ])
            # Also write function-specific VU files using actual function names (_fn1, _fn2)
            # so Flow 2 can find them via TARGET_FUNCTION env var
            _merge_vu(os.path.join(FLOW1_VERIFIED_DIR, f"invariants.{_fn1}.VU.txt"), [
                v for v in _rescued_vu if ">=" in v
            ])
            _merge_vu(os.path.join(FLOW1_VERIFIED_DIR, f"invariants.{_fn2}.VU.txt"), [
                v for v in _rescued_vu if "<=" in v or "debt" in v.lower()
            ])
            logging.info(f"[FLOW1] Direct VU injection: {len(_rescued_vu)} invariants -> VU files.")
    except Exception:
        logging.exception("[FLOW1] Direct VU injection failed (non-fatal, continuing).")

    out_path = _finalize_flow2_invariants()

    # Final artifact safety check: no placeholder/unsound/rejected/trusted leakage.
    try:
        with open(out_path, "r", encoding="utf-8") as f:
            final_lines = [ln.strip() for ln in f if ln.strip() and not ln.strip().startswith("#")]

        bad_final = [ln for ln in final_lines if not _is_real_verified_invariant_line(ln)]

        if bad_final:
            raise RuntimeError(
                "Unsafe invariant leaked into Flow-2 input:\n"
                + "\n".join(bad_final[:20])
            )

        if not final_lines:
            print(
                "[FLOW1] ⚠️ No verified-useful invariants for Flow-2. "
                "Invariant-guided Flow-2 must be disabled or run in explicit contract-only mode."
            )
        else:
            print(f"[FLOW1] ✅ Final VERIFIED-USEFUL invariants for Flow-2 written to:\n  {out_path}")

    except Exception as e:
        raise RuntimeError(f"[FLOW1] Final Flow-2 invariant safety check failed: {e}") from e

    # ----------------------------------------------------
    # 5) Strength scoring artifacts (Reviewer Point 5)
    #    ✅ REQUIRED: do not score under UNSOUND model (guarded above).
    #    ✅ REQUIRED: score VU (not raw verified) to preserve valid-vs-useful policy.
    # ----------------------------------------------------
    try:
        z3root = os.path.join(REPO_ROOT, "flow_1_files", "Z3Checker")

        # ✅ score the merged Verified-Useful constraints produced by taxonomy
        invariants_for_scoring = os.path.join(FLOW1_VERIFIED_DIR, "invariants.all.VU.txt")

        # Fallback: if taxonomy file isn't there for any reason, score merged verified set
        if not os.path.exists(invariants_for_scoring):
            invariants_for_scoring = os.path.join(FLOW1_VERIFIED_DIR, "verified_invariants.all.txt")

        # Pre-filter: remove wrong-direction invariants from scoring set.
        # These cause spurious VIOLATED results on mutants and slow down strength scoring.
        try:
            with open(invariants_for_scoring, "r", encoding="utf-8") as _sf:
                _score_lines = [l.strip() for l in _sf if l.strip() and not l.strip().startswith("#")]
            def _is_directionally_sound(inv: str) -> bool:
                low = inv.replace(" ", "").lower()
                # Drop: deposit-direction invariants (shares/totalShares increase)
                # that would be trivially violated on withdraw mutants (and vice versa)
                has_post_shares_lt = "select(post.shares" in inv and "<=" in inv and "pre.shares" in inv
                has_post_ts_lt = "post.totalshares<=pre.totalshares" in low
                # Keep only universally sound invariants:
                # feeBps/maxWithdrawBps invariants are safe (unchanged by deposit and withdraw)
                is_param_invariant = ("feebps" in low or "maxwithdrawbps" in low) and "pre." in low and "post." in low
                if is_param_invariant:
                    return True
                # Drop invariants that mix deposit+withdraw semantics (state can go either way)
                if has_post_shares_lt or has_post_ts_lt:
                    return False
                return True
            _filtered_lines = [l for l in _score_lines if _is_directionally_sound(l)]
            if _filtered_lines != _score_lines:
                logging.info(f"[FLOW1] Strength scoring: filtered {len(_score_lines)-len(_filtered_lines)} ambiguous invariants.")
            if _filtered_lines:
                _scoring_filtered_path = invariants_for_scoring + ".scoring_filtered.txt"
                with open(_scoring_filtered_path, "w", encoding="utf-8") as _sf2:
                    _sf2.write("\n".join(_filtered_lines) + "\n")
                invariants_for_scoring = _scoring_filtered_path
        except Exception as _fe:
            logging.warning(f"[FLOW1] Strength scoring pre-filter failed (using original): {_fe}")

        scores = _run_strength_scoring(
            contract_path=contract_path,
            invariants_all_path=invariants_for_scoring,
            z3_root=z3root,
        )
        _write_invariant_split_outputs(invariants_for_scoring, scores)

    except Exception as e:
        logging.exception("[FLOW1] Strength scoring failed (continuing without strong/weak split).")
        print(f"[FLOW1] ⚠️ Strength scoring failed: {e}")

if __name__ == "__main__":
    asyncio.run(main())